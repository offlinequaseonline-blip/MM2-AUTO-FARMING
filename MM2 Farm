RunService.RenderStepped:Connect(function(DeltaTime)
    local Now = tick()

    if Now - LastUITimerUpdate > 1 then
        LastUITimerUpdate = Now
        ScriptTimeLabel.Text = string.format("Script Time: %ds", math.floor(Now - getgenv().ScriptStartTime))
        ServerTimeLabel.Text = string.format("Server Time: %ds", math.floor(Now - getgenv().ServerJoinTime))
    end

    local Char = GetCharacter()
    local HRP = GetHRP()
    local Hum = GetHumanoid()
    if not Char or not HRP or not Hum then return end

    if Now - LastBagCheck > 1 then
        LastBagCheck = Now
        local RealBag = GetBagCoins()
        if RealBag ~= nil then
            if LocalBagCoins > 0 and RealBag > LocalBagCoins then
                LocalTotalCoins = LocalTotalCoins + (RealBag - LocalBagCoins)
            end
            LocalBagCoins = RealBag
        end
        BagLabel.Text = "Bag: " .. LocalBagCoins
        TotalLabel.Text = "Total: " .. LocalTotalCoins

        local RealCandy = GetCandyCount()
        if RealCandy ~= nil then
            if LocalCandyCoins > 0 and RealCandy > LocalCandyCoins then
                LocalCandyCollected = LocalCandyCollected + (RealCandy - LocalCandyCoins)
            end
            LocalCandyCoins = RealCandy
        end
        CandyLabel.Text = "Candy: " .. LocalCandyCoins
        CandyCollectedLabel.Text = "Candy Collected: " .. LocalCandyCollected
    end

    if Now - LastESPUpdate > 0.25 then
        LastESPUpdate = Now
        UpdateCoinESP()
        UpdatePlayerESP()
        UpdateGunTracking()
    end

    if not Settings.AutoFarm then return end
    if not IsPlaying() then
        StatusLabel.Text = "Waiting for match to start..."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 180, 0)
        Hum.PlatformStand = false
        Hum.WalkSpeed = 16
        return
    end

    if LocalBagCoins < BagFullThreshold and HasActivatedFullBagAction then
        HasActivatedFullBagAction = false
        HasShotMurder = false
        HasKilledAll = false
    end

    if Now - LastNoclipApply > 0.5 and Settings.Mode ~= "Walk" then
        LastNoclipApply = Now
        SetNoclip(true)
    end

    StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
    local Nearest, Distance = GetNearestTarget(HRP.Position)
    if not Nearest then
        StatusLabel.Text = "No coins found"
        return
    end

    local Watching = CheckSomeoneWatching()
    local SafeDistance = Watching and MinPlayerDistance or 0

    if Settings.Mode == "Fly" then
        Hum.PlatformStand = true
        workspace.Gravity = 0
        if Distance > 6 then
            local Direction = (Nearest.Position - HRP.Position).Unit
            if Distance > SafeDistance then
                HRP.Velocity = Vector3.zero
                HRP.CFrame = CFrame.new(HRP.Position + Direction * Settings.MaxSpeed * DeltaTime)
                StatusLabel.Text = string.format("Fly -> %.0f studs", Distance)
            else
                HRP.Velocity = Vector3.zero
                StatusLabel.Text = "Maintaining distance..."
            end
        else
            HRP.Velocity = Vector3.zero
            local Spin = tick() * 6
            local Bob = math.sin(tick() * 4) * 1.5
            HRP.CFrame = CFrame.new(Nearest.Position + Vector3.new(0, 2 + Bob, 0)) * CFrame.Angles(0, Spin, 0)
            StatusLabel.Text = "Collecting (Fly)..."
        end

    elseif Settings.Mode == "TP" then
        Hum.PlatformStand = true
        workspace.Gravity = 0
        if Distance > 6 then
            if Now - LastTPTime > TP_DELAY then
                LastTPTime = Now
                local Offset = Vector3.new(math.random(-2, 2), math.random(0, 3), math.random(-2, 2))
                HRP.Velocity = Vector3.zero
                HRP.CFrame = CFrame.new(Nearest.Position + Offset)
            end
            StatusLabel.Text = string.format("TP -> %.0f studs (%.2fs)", Distance, TP_DELAY)
        else
            HRP.Velocity = Vector3.zero
            StatusLabel.Text = "Collecting (TP)..."
        end

    elseif Settings.Mode == "Walk" then
        Hum.PlatformStand = false
        Hum.WalkSpeed = math.clamp(Settings.MaxSpeed, 25, 50)
        workspace.Gravity = 196.2

        if HRP.Position.Y < -50 then
            HRP.CFrame = CFrame.new(Nearest.Position + Vector3.new(0, 5, 0))
            StatusLabel.Text = "Void detected, teleporting back!"
            return
        end

        local Murder
        for _, P in ipairs(Players:GetPlayers()) do
            if P ~= LocalPlayer and GetPlayerRole(P) == "Murderer" then Murder = P; break end
        end
        if Murder and Murder.Character then
            local MurderHRP = Murder.Character:FindFirstChild("HumanoidRootPart")
            if MurderHRP and (MurderHRP.Position - HRP.Position).Magnitude < 50 then
                local FleeDir = (HRP.Position - MurderHRP.Position).Unit
                HRP.CFrame = HRP.CFrame + FleeDir * 50 * DeltaTime
                StatusLabel.Text = "Fleeing from Murderer!"
                return
            end
        end

        if Distance > 25 then
            if not WalkPath or (Now - LastTargetRefresh > 2) then
                LastTargetRefresh = Now
                WalkPath = PathfindingService:CreatePath({AgentHeight = 5, AgentRadius = 2, AgentCanJump = true, WaypointSpacing = 4})
                local Success = pcall(function() WalkPath:ComputeAsync(HRP.Position, Nearest.Position) end)
                if not Success or WalkPath.Status ~= Enum.PathStatus.Success then WalkPath = nil end
                WalkIndex = 1
            end
            if WalkPath then
                local Waypoints = WalkPath:GetWaypoints()
                if WalkIndex <= #Waypoints then
                    local Waypoint = Waypoints[WalkIndex]
                    if (HRP.Position - Waypoint.Position).Magnitude < 3 then
                        WalkIndex = WalkIndex + 1
                        Waypoint = Waypoints[math.min(WalkIndex, #Waypoints)]
                    end
                    Hum:MoveTo(Waypoint.Position)
                    if Waypoint.Action == Enum.PathWaypointAction.Jump then Hum.Jump = true end
                end
            else
                Hum:MoveTo(Nearest.Position)
                if Nearest.Position.Y - HRP.Position.Y > 3 then Hum.Jump = true end
            end
        else
            Hum:MoveTo(Nearest.Position)
            if Nearest.Position.Y - HRP.Position.Y > 3 then Hum.Jump = true end
        end
        StatusLabel.Text = string.format("Walk -> %.0f studs", Distance)

        if (HRP.Position - LastPos).Magnitude < 0.5 then
            if Now - LastPosTime > 1.5 then
                Hum.Jump = true
                LastPosTime = Now
            end
        else
            LastPos = HRP.Position
            LastPosTime = Now
        end
    end

    if LocalBagCoins >= BagFullThreshold and not HasActivatedFullBagAction then
        HasActivatedFullBagAction = true
        FullBagActionTime = Now
        local Role = GetPlayerRole(LocalPlayer)
        if Role == "Murderer" then KillAllPlayers()
        elseif Role == "Sheriff" or Role == "Hero" then ShootMurderer() end
    end

    if HasActivatedFullBagAction and not HasShotMurder and not HasKilledAll then
        local Role = GetPlayerRole(LocalPlayer)
        if Role == "Innocent" then
            local Gun = GetMyTool("gun")
            if Gun then ShootMurderer()
            elseif Now - FullBagActionTime > FlingDelay then FlingMurderer() end
        end
    end
end)
