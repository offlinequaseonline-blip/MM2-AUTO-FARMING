local function isCoin(obj)
    return obj:IsA("BasePart") and obj.Name:match(CONFIG.COIN_PATTERN) and obj.Transparency < 1
end

local function refreshCoins()
    local now = tick()
    if now - lastScan < CONFIG.SCAN_INTERVAL then return end
    lastScan = now
    coinCache = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isCoin(obj) and obj.Parent then
            table.insert(coinCache, obj)
        end
    end
end

local function getBagCoins()
    local stat = player:FindFirstChild(CONFIG.BAG_COIN_ATTRIBUTE)
    if stat and stat:IsA("IntValue") then return stat.Value end
    local gui = player:FindFirstChild("PlayerGui")
    if gui then
        for _, obj in ipairs(gui:GetDescendants()) do
            if obj:IsA("IntValue") and obj.Name:match("Coin") then return obj.Value end
            if obj:IsA("TextLabel") and obj.Name:match("Coin") then
                local num = tonumber(obj.Text:match("%d+"))
                if num then return num end
            end
        end
    end
    return nil
end

local function getPlayerRole()
    local char = player.Character
    if not char then return "Innocent" end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            local name = tool.Name:lower()
            if name:find("knife") or name:find("murder") then return "Murderer" end
            if name:find("gun") or name:find("sheriff") then return "Sheriff" end
        end
    end
    return "Innocent"
end

local function getMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local char = p.Character
            if char then
                for _, tool in ipairs(char:GetChildren()) do
                    if tool:IsA("Tool") and tool.Name:lower():find("knife") then
                        return p
                    end
                end
            end
        end
    end
    return nil
end

local function fireRemote(remoteName, ...)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then return end
    local remote = remotes:FindFirstChild(remoteName)
    if remote and remote:IsA("RemoteEvent") then
        remote:FireServer(...)
    end
end

local function killAll()
    local murderer = getMurderer()
    if not murderer then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    fireRemote("Kill", p)
                    fireRemote("Attack", p)
                end
            end
        end
    else
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    fireRemote("Kill", p)
                    fireRemote("Attack", p)
                end
            end
        end
    end
end

local function shootMurder()
    local murderer = getMurderer()
    if not murderer or not murderer.Character then return end
    local targetHRP = murderer.Character:FindFirstChild("HumanoidRootPart")
    local char = player.Character
    if not targetHRP or not char then return end
    local myHRP = char:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    myHRP.CFrame = CFrame.lookAt(myHRP.Position, targetHRP.Position)
    fireRemote("Shoot", targetHRP.Position)
    fireRemote("Fire", targetHRP.Position)
    hasShotMurder = true
end

local function flingMurder()
    local murderer = getMurderer()
    if not murderer or not murderer.Character then return end
    local hrp = murderer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local bv = Instance.new("BodyAngularVelocity")
    bv.AngularVelocity = Vector3.new(math.huge, math.huge, math.huge)
    bv.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bv.Parent = hrp
    task.delay(1, function() if bv then bv:Destroy() end end)
end

local function activateNoclip(enable)
    local char = player.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not enable
        end
    end
end

local function setFlying(state)
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if state then
        if hum then hum.PlatformStand = true end
        workspace.Gravity = 0
        activateNoclip(true)
        flying = true
        statusLbl.Text = "Voando"
        statusLbl.TextColor3 = Color3.fromRGB(0, 255, 150)
    else
        if hum then hum.PlatformStand = false end
        workspace.Gravity = savedGravity
        activateNoclip(false)
        flying = false
        currentTarget = nil
        statusLbl.Text = "Pressione E para iniciar"
        statusLbl.TextColor3 = Color3.fromRGB(150, 160, 190)
        targetLbl.Text = ""
    end
end

local function bypassTp(targetPos)
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if hrp:FindFirstChildOfClass("BodyVelocity") then
        hrp:FindFirstChildOfClass("BodyVelocity"):Destroy()
    end
    local offset = Vector3.new(
        math.random(-CONFIG.TP_OFFSET_RANGE, CONFIG.TP_OFFSET_RANGE),
        math.random(-CONFIG.TP_OFFSET_RANGE, CONFIG.TP_OFFSET_RANGE),
        math.random(-CONFIG.TP_OFFSET_RANGE, CONFIG.TP_OFFSET_RANGE)
    )
    hrp.Velocity = Vector3.zero
    hrp.CFrame = CFrame.new(targetPos + offset)
    task.wait(0.1)
    hrp.Velocity = Vector3.zero
end

local function updateEsp()
    for _, bb in ipairs(espBillboards) do
        if bb then bb:Destroy() end
    end
    espBillboards = {}
    if not espEnabled then return end
    refreshCoins()
    for _, coin in ipairs(coinCache) do
        if coin.Parent then
            local billboard = Instance.new("BillboardGui")
            billboard.Size = UDim2.new(0, 200, 0, 50)
            billboard.StudsOffset = Vector3.new(0, 2, 0)
            billboard.AlwaysOnTop = true
            billboard.Parent = coin
            local text = Instance.new("TextLabel")
            text.Size = UDim2.new(1, 0, 1, 0)
            text.BackgroundTransparency = 1
            text.TextColor3 = Color3.fromRGB(0, 255, 180)
            text.Font = Enum.Font.GothamBold
            text.TextSize = 12
            text.Text = string.format("%s\n%.0f studs", coin.Name, (coin.Position - player.Character.HumanoidRootPart.Position).Magnitude)
            text.Parent = billboard
            table.insert(espBillboards, billboard)
        end
    end
end

local function checkVision()
    local char = player.Character
    if not char then return false end
    local myHRP = char:FindFirstChild("HumanoidRootPart")
    if not myHRP then return false end
    local myPos = myHRP.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local theirHRP = p.Character:FindFirstChild("HumanoidRootPart")
            if theirHRP then
                local look = theirHRP.CFrame.LookVector
                local towards = (myPos - theirHRP.Position).Unit
                local dot = look:Dot(towards)
                local angle = math.deg(math.acos(math.clamp(dot, -1, 1)))
                if angle <= CONFIG.VISION_FOV_ANGLE then
                    local ray = Ray.new(theirHRP.Position, (myPos - theirHRP.Position).Unit * CONFIG.VISION_MAX_DISTANCE)
                    local hit = workspace:FindPartOnRay(ray, p.Character)
                    if hit and hit:IsDescendantOf(char) then
                        return true
                    end
                end
            end
        end
    end
    return false
end

local function serverHop()
    local success, servers = pcall(function()
        return TeleportService:GetPublicServersAsync(game.PlaceId)
    end)
    if success and servers and #servers > 1 then
        for _, server in ipairs(servers) do
            if server.Id ~= game.JobId then
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, server.Id, player)
                end)
                break
            end
        end
    end
end

local function checkServerHop()
    local now = tick()
    if now - lastServerHop < CONFIG.SERVER_HOP_INTERVAL then return end
    lastServerHop = now
    local players = Players:GetPlayers()
    if #players < CONFIG.MIN_PLAYERS then
        serverHop()
        return
    end
    for _, p in ipairs(players) do
        if p ~= player then
            local name = p.Name:lower()
            if name:find("admin") or name:find("owner") or name:find("mod") then
                serverHop()
                return
            end
        end
    end
end

