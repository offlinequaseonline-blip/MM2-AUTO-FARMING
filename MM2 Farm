local function UpdateCoinESP()
    if not Settings.ESPCoins then
        ClearCoinESP()
        return
    end
    local HRP = GetHRP()
    if not HRP then return end
    local CamPos = Camera.CFrame.Position
    local MyChar = GetCharacter()

    local CoinList = {}
    for _, Obj in ipairs(workspace:GetDescendants()) do
        if IsCoin(Obj) and Obj.Parent then
            table.insert(CoinList, Obj)
        end
    end
    table.sort(CoinList, function(a, b)
        return (a.Position - HRP.Position).Magnitude < (b.Position - HRP.Position).Magnitude
    end)
    local ClosestCoins = {}
    for i = 1, math.min(10, #CoinList) do
        ClosestCoins[CoinList[i]] = true
    end

    for Coin, Data in pairs(ESPCoinData) do
        if not Coin or not Coin.Parent or not IsCoin(Coin) or not ClosestCoins[Coin] then
            if Data.Highlight then Data.Highlight:Destroy() end
            if Data.Billboard then Data.Billboard:Destroy() end
            ESPCoinData[Coin] = nil
        end
    end

    for _, Coin in ipairs(CoinList) do
        if ClosestCoins[Coin] then
            if not ESPCoinData[Coin] then
                ESPCoinData[Coin] = CreateCoinESP(Coin)
            end
            local Data = ESPCoinData[Coin]
            if Data then
                local Direction = Coin.Position - CamPos
                local Distance = Direction.Magnitude
                local Params = RaycastParams.new()
                Params.FilterDescendantsInstances = {Coin, MyChar}
                Params.FilterType = Enum.RaycastFilterType.Exclude
                local Result = workspace:Raycast(CamPos, Direction, Params)
                local Occluded = Result ~= nil and Result.Distance < Distance - 2

                Data.Highlight.Enabled = Occluded
                Data.Billboard.Enabled = Occluded

                if Occluded then
                    local DistStuds = math.floor((Coin.Position - HRP.Position).Magnitude)
                    Data.Label.Text = string.format("%s | %d studs", Coin.Name, DistStuds)
                end
            end
        end
    end
end

local function UpdatePlayerESP()
    if not Settings.ESPPlayers then
        ClearPlayerESP()
        return
    end
    local HRP = GetHRP()
    if not HRP then return end

    for Player, Data in pairs(ESPPlayerData) do
        if not Player or not Player.Character or not Player.Character.Parent then
            if Data.Highlight then Data.Highlight:Destroy() end
            if Data.Billboard then Data.Billboard:Destroy() end
            ESPPlayerData[Player] = nil
        end
    end

    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
            if not ESPPlayerData[Player] then
                ESPPlayerData[Player] = CreatePlayerESP(Player)
            end
            local Data = ESPPlayerData[Player]
            if Data then
                local Role = GetPlayerRole(Player)
                local Color
                if Role == "Murderer" then Color = Color3.fromRGB(255, 50, 50)
                elseif Role == "Sheriff" then Color = Color3.fromRGB(50, 150, 255)
                elseif Role == "Hero" then Color = Color3.fromRGB(255, 255, 0)
                else Color = Color3.fromRGB(50, 255, 50) end

                Data.Highlight.FillColor = Color
                Data.Highlight.OutlineColor = Color
                local Dist = math.floor((Player.Character.HumanoidRootPart.Position - HRP.Position).Magnitude)
                Data.Label.Text = string.format("%s [%s] | %d studs", Player.Name, Role, Dist)
                Data.Label.TextColor3 = Color
            end
        end
    end
end

local function UpdateGunESP()
    if not Settings.ESPGun then
        ClearGunESP()
        return
    end
    local GunPart = nil
    for _, Obj in ipairs(workspace:GetDescendants()) do
        if (Obj.Name == "Gun") and (Obj:IsA("BasePart") or Obj:IsA("Tool")) then
            local isEquipped = false
            for _, Player in ipairs(Players:GetPlayers()) do
                if Player.Character and Obj:IsDescendantOf(Player.Character) then
                    isEquipped = true
                    break
                end
            end
            if not isEquipped then
                GunPart = Obj
                break
            end
        end
    end

    if GunPart then
        if not ESPGunData or ESPGunData.Highlight.Adornee ~= GunPart then
            ClearGunESP()
            ESPGunData = CreateGunESP(GunPart)
        end
        if not GunNotified then
            pcall(function()
                StarterGui:SetCore("SendNotification", {
                    Title = "Gun Dropped",
                    Text = "The Sheriff's gun has been dropped!",
                    Duration = 5
                })
            end)
            GunNotified = true
        end
    else
        ClearGunESP()
    end
end

