local function HandleWaitingMatch(dt)
    local HRP, Hum = GetHRP(), GetHumanoid()
    if not HRP or not Hum then StatusLbl.Text = "Waiting char..."; return end
    if Hum.Health <= 0 then StatusLbl.Text = "Dead, waiting..."; return end
    EnableFly()
    HRP.Velocity = Vector3.zero
    if IsMatchActive() and tick() - CharChangedAt > 1 then
        FarmState = "FlyingToMap"
        StatusLbl.Text = "Match! Flying to map..."
        return
    end
    StatusLbl.Text = "Waiting for match..."
end

local function HandleFlyingToMap(dt)
    local HRP, Hum = GetHRP(), GetHumanoid()
    if not HRP or not Hum or Hum.Health <= 0 then return end
    EnableFly()
    local target, bestDist = nil, math.huge
    for _, o in ipairs(CachedCoins) do
        if o.Parent then
            local d = (o.Position - HRP.Position).Magnitude
            if d < bestDist then target = o.Position; bestDist = d end
        end
    end
    if not target then target = MapCenter end
    if not target then StatusLbl.Text = "No target..."; return end
    local dist = FlyTowards(HRP, target, dt)
    StatusLbl.Text = string.format("Flying to map: %.0f", dist)
    if dist < 15 then
        FarmState = "Farming"
        DisableFly()
        StatusLbl.Text = "Farming!"
    end
end

local function HandleFarming(dt)
    local HRP, Hum = GetHRP(), GetHumanoid()
    if not HRP or not Hum or Hum.Health <= 0 then return end

    Hum.PlatformStand = false
    Hum.WalkSpeed = WALK_SPEED
    Hum.JumpPower = 0
    Hum.JumpHeight = 0
    workspace.Gravity = 0
    ApplyNoclip()

    local m = CachedMurderer
    local mHRP = m and m.Character and m.Character:FindFirstChild("HumanoidRootPart")

    if mHRP and (mHRP.Position - HRP.Position).Magnitude < FLEE_DIST then
        FarmState = "FleeingUnderground"
        SafeSince = nil
        StatusLbl.Text = "Fleeing underground!"
        return
    end

    if GetLocalRole() == "Innocent" and not GetMyTool("gun") then
        local gun = FindDroppedGun()
        if gun then
            GunPickupTarget = gun
            FarmState = "PickingGun"
            StatusLbl.Text = "Picking up gun!"
            return
        end
    end

    local target = GetBestCoin(HRP, m)
    if not target then StatusLbl.Text = "No coins"; return end

    local dist = (target.Position - HRP.Position).Magnitude
    local yDiff = math.abs(target.Position.Y - HRP.Position.Y)
    local mapY = MapCenter and MapCenter.Y or 0
    local coinUnderground = target.Position.Y < (mapY - 30)
    local coinTooHigh = target.Position.Y > (mapY + 60)

    -- Se a moeda está muito abaixo do mapa OU muito acima, ela não é alcançável andando
    if coinUnderground or coinTooHigh then
        FlyToCoinTarget = target
        FlyToCoinStart = tick()
        FarmState = "FlyingToCoin"
        StatusLbl.Text = "Coin unreachable by walk, flying!"
        return
    end

    if dist > 6 then
        if dist > 25 then
            if not WalkPath or (tick() - LastTargetRefresh > 2) then
                LastTargetRefresh = tick()
                WalkPath = PathfindingService:CreatePath({
                    AgentHeight = 5, AgentRadius = 2, AgentCanJump = false, WaypointSpacing = 4
                })
                local ok = pcall(function() WalkPath:ComputeAsync(HRP.Position, target.Position) end)
                if not ok or WalkPath.Status ~= Enum.PathStatus.Success then WalkPath = nil end
                WalkIndex = 1
            end
            if WalkPath then
                local wps = WalkPath:GetWaypoints()
                if WalkIndex <= #wps then
                    local wp = wps[WalkIndex]
                    if (HRP.Position - wp.Position).Magnitude < 3 then
                        WalkIndex = WalkIndex + 1
                        wp = wps[math.min(WalkIndex, #wps)]
                    end
                    Hum:MoveTo(wp.Position)
                    if math.abs(HRP.Position.Y - wp.Position.Y) > 2 then
                        HRP.CFrame = CFrame.new(HRP.Position.X, wp.Position.Y + 1, HRP.Position.Z)
                    end
                end
            else
                FlyToCoinTarget = target
                FlyToCoinStart = tick()
                FarmState = "FlyingToCoin"
                StatusLbl.Text = "Path failed, flying!"
                return
            end
        else
            Hum:MoveTo(target.Position)
            if yDiff > 2 then
                HRP.CFrame = CFrame.new(HRP.Position.X, target.Position.Y + 1, HRP.Position.Z)
            end
        end
    else
        HRP.CFrame = CFrame.new(target.Position + Vector3.new(0, 2, 0))
    end

    StatusLbl.Text = string.format("Farm -> %.0f", dist)

    -- Detecção de travamento: se não moveu 2s, entra em fly
    if (HRP.Position - LastPos).Magnitude < 0.5 then
        if not StuckStart then StuckStart = tick() end
        if tick() - StuckStart > 2 then
            FlyToCoinTarget = target
            FlyToCoinStart = tick()
            StuckStart = nil
            FarmState = "FlyingToCoin"
            StatusLbl.Text = "Stuck, flying to coin!"
            return
        end
    else
        StuckStart = nil
        LastPos = HRP.Position
        LastPosTime = tick()
    end
end

local function HandleFlyingToCoin(dt)
    local HRP, Hum = GetHRP(), GetHumanoid()
    if not HRP or not Hum or Hum.Health <= 0 then return end
    EnableFly()

    if not FlyToCoinTarget or not FlyToCoinTarget.Parent then
        FlyToCoinTarget = nil
        FarmState = "Farming"
        return
    end

    if tick() - FlyToCoinStart > FLY_TIMEOUT then
        FlyToCoinTarget = nil
        FarmState = "Farming"
        StatusLbl.Text = "Fly timeout, back to farming"
        return
    end

    local m = CachedMurderer
    local mHRP = m and m.Character and m.Character:FindFirstChild("HumanoidRootPart")
    if mHRP and (mHRP.Position - HRP.Position).Magnitude < FLEE_DIST then
        FlyToCoinTarget = nil
        FarmState = "FleeingUnderground"
        return
    end

    local targetPos = FlyToCoinTarget.Position + Vector3.new(0, 2, 0)
    local dist = FlyTowards(HRP, targetPos, dt)
    StatusLbl.Text = string.format("Flying to coin: %.0f", dist)

    if dist < 3 then
        HRP.Velocity = Vector3.zero
        HRP.CFrame = CFrame.new(targetPos)
        FlyToCoinTarget = nil
        task.delay(0.3, function()
            if FarmState == "FlyingToCoin" then FarmState = "Farming" end
        end)
    end
end

local function HandleFleeingUnderground(dt)
    local HRP, Hum = GetHRP(), GetHumanoid()
    if not HRP or not Hum or Hum.Health <= 0 then return end
    EnableFly()

    local mapY = MapCenter and MapCenter.Y or 0
    local undergroundY = mapY - UNDERGROUND_DEPTH
    local m = CachedMurderer
    local mHRP = m and m.Character and m.Character:FindFirstChild("HumanoidRootPart")

    local target, bestScore = nil, -math.huge
    for _, o in ipairs(CachedCoins) do
        if o.Parent then
            local score = 0
            if mHRP then score = (o.Position - mHRP.Position).Magnitude end
            score = score - (o.Position - HRP.Position).Magnitude * 0.3
            if score > bestScore then target = o; bestScore = score end
        end
    end
    if not target then StatusLbl.Text = "No coins underground"; return end

    local targetPos = Vector3.new(target.Position.X, undergroundY, target.Position.Z)
    local dist = FlyTowards(HRP, targetPos, dt)
    StatusLbl.Text = string.format("Underground -> %.0f", dist)

    if dist < 10 then
        UnderCoin = target
        UndergroundPhase = "rising"
        FarmState = "GrabbingUnderground"
        return
    end

    if mHRP then
        if HorizontalDist(mHRP, HRP) > SAFE_DIST then
            if not SafeSince then SafeSince = tick() end
            if tick() - SafeSince > SAFE_TIME then
                FarmState = "ReturningToSurface"
                SafeSince = nil
            end
        else
            SafeSince = nil
        end
    end
end

local function HandleGrabbingUnderground(dt)
    local HRP, Hum = GetHRP(), GetHumanoid()
    if not HRP or not Hum or Hum.Health <= 0 then return end
    EnableFly()

    if not UnderCoin or not UnderCoin.Parent then
        UnderCoin = nil; UndergroundPhase = nil
        FarmState = "FleeingUnderground"
        return
    end

    local mapY = MapCenter and MapCenter.Y or 0
    local undergroundY = mapY - UNDERGROUND_DEPTH

    if UndergroundPhase == "rising" then
        local targetPos = UnderCoin.Position + Vector3.new(0, 2, 0)
        local dist = FlyTowards(HRP, targetPos, dt)
        StatusLbl.Text = string.format("Rising to grab: %.0f", dist)
        if dist < 3 then
            UndergroundPhase = "grabbing"
            task.delay(0.3, function()
                if UndergroundPhase == "grabbing" then UndergroundPhase = "diving" end
            end)
        end
    elseif UndergroundPhase == "grabbing" then
        HRP.Velocity = Vector3.zero
        StatusLbl.Text = "Grabbing..."
    elseif UndergroundPhase == "diving" then
        local targetPos = Vector3.new(HRP.Position.X, undergroundY, HRP.Position.Z)
        local dist = FlyTowards(HRP, targetPos, dt)
        StatusLbl.Text = "Diving back down..."
        if dist < 5 then
            UnderCoin = nil; UndergroundPhase = nil
            local m = CachedMurderer
            local mHRP = m and m.Character and m.Character:FindFirstChild("HumanoidRootPart")
            if mHRP and HorizontalDist(mHRP, HRP) < FLEE_DIST then
                FarmState = "FleeingUnderground"
            else
                FarmState = "ReturningToSurface"
            end
        end
    end
end

local function HandleReturningToSurface(dt)
    local HRP, Hum = GetHRP(), GetHumanoid()
    if not HRP or not Hum or Hum.Health <= 0 then return end
    EnableFly()
    local mapY = MapCenter and MapCenter.Y or 5
    local surfaceY = mapY + 5
    local targetPos = Vector3.new(HRP.Position.X, surfaceY, HRP.Position.Z)
    local dist = FlyTowards(HRP, targetPos, dt)
    StatusLbl.Text = string.format("Returning to surface: %.0f", dist)

    local m = CachedMurderer
    local mHRP = m and m.Character and m.Character:FindFirstChild("HumanoidRootPart")
    if mHRP and HorizontalDist(mHRP, HRP) < FLEE_DIST then
        FarmState = "FleeingUnderground"
        return
    end
    if dist < 3 then
        DisableFly()
        FarmState = "Farming"
    end
end

local function HandlePickingGun(dt)
    local HRP, Hum = GetHRP(), GetHumanoid()
    if not HRP or not Hum or Hum.Health <= 0 then return end

    if not GunPickupTarget or not GunPickupTarget.Parent then
        GunPickupTarget = nil; FarmState = "Farming"; return
    end

    local owned = false
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and GunPickupTarget:IsDescendantOf(p.Character) then owned = true; break end
        local bp = p:FindFirstChild("Backpack")
        if bp and GunPickupTarget:IsDescendantOf(bp) then owned = true; break end
    end
    if owned or GetMyTool("gun") then
        GunPickupTarget = nil; FarmState = "Farming"; return
    end

    local m = CachedMurderer
    local mHRP = m and m.Character and m.Character:FindFirstChild("HumanoidRootPart")
    if mHRP and (mHRP.Position - HRP.Position).Magnitude < FLEE_DIST then
        GunPickupTarget = nil; FarmState = "FleeingUnderground"; return
    end

    EnableFly()
    local dist = FlyTowards(HRP, GunPickupTarget.Position + Vector3.new(0, 2, 0), dt)
    StatusLbl.Text = string.format("Getting gun: %.0f", dist)
end

RunService.RenderStepped:Connect(function(dt)
    UpdateCache()
    local HRP = GetHRP()

    if tick() - LastESPUpdate > 0.25 then
        LastESPUpdate = tick()
        UpdateCoinESP()
    end

    if tick() - LastBagCheck > 1 then
        LastBagCheck = tick()
        local bag = GetBagCoins()
        if bag ~= nil then LocalBagCoins = bag end
        BagLbl.Text = "Bag: " .. LocalBagCoins .. " / " .. BAG_THRESHOLD
    end

    if #Players:GetPlayers() <= 1 then
        if not AloneStartTime then AloneStartTime = tick() end
        if tick() - AloneStartTime > ALONE_TIMEOUT then
            AloneStartTime = nil
            ServerHop()
            return
        end
    else
        AloneStartTime = nil
    end

    if not Settings.AutoFarm then return end
    if not HRP then return end

    local inUnderground = FarmState == "FleeingUnderground" or FarmState == "GrabbingUnderground"
    if not inUnderground and HRP.Position.Y < VOID_Y then
        EnableFly()
        local safe = MapCenter or Vector3.new(0, 50, 0)
        FlyTowards(HRP, Vector3.new(safe.X, safe.Y + 30, safe.Z), dt)
        StatusLbl.Text = "Void rescue!"
        return
    end

    if LocalBagCoins < BAG_THRESHOLD and HasActivatedFullBagAction then
        HasActivatedFullBagAction = false
        HasShotMurder = false
        HasKilledAll = false
    end

    if LocalBagCoins >= BAG_THRESHOLD and not HasActivatedFullBagAction then
        HasActivatedFullBagAction = true
        local role = GetLocalRole()
        if role == "Murderer" then
            KillAllPlayers()
        elseif role == "Sheriff" then
            ShootMurderer()
        elseif role == "Innocent" then
            if GetMyTool("gun") then
                ShootMurderer()
            elseif FindDroppedGun() then
                GunPickupTarget = FindDroppedGun()
                FarmState = "PickingGun"
            else
                FlingMurderer()
            end
        end
    end

    if FarmState == "WaitingMatch" then HandleWaitingMatch(dt)
    elseif FarmState == "FlyingToMap" then HandleFlyingToMap(dt)
    elseif FarmState == "Farming" then HandleFarming(dt)
    elseif FarmState == "FlyingToCoin" then HandleFlyingToCoin(dt)
    elseif FarmState == "FleeingUnderground" then HandleFleeingUnderground(dt)
    elseif FarmState == "GrabbingUnderground" then HandleGrabbingUnderground(dt)
    elseif FarmState == "ReturningToSurface" then HandleReturningToSurface(dt)
    elseif FarmState == "PickingGun" then HandlePickingGun(dt)
    end
end)
