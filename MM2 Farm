local function IsInCharacter(Obj)
    local a = Obj.Parent
    while a do
        if a:IsA("Model") and a:FindFirstChildOfClass("Humanoid") then return true end
        if a:IsA("Backpack") then return true end
        if a == workspace then return false end
        a = a.Parent
    end
    return false
end

local function IsCoin(Obj)
    if not Obj:IsA("BasePart") then return false end
    if Obj.Transparency >= 1 then return false end
    local n = Obj.Name
    if not (n:match("^Coin") or n:match("^Candy") or n:match("^Treat")) then return false end
    if n:match("Spawn") or n:match("Sign") or n:match("Board") or n:match("Point") or n:match("Decal") or n:match("Gui") then
        return false
    end
    if Obj.Size.Magnitude > 25 then return false end
    if IsInCharacter(Obj) then return false end
    return true
end

