local function GetBestCoin(HRP, Murderer)
    local myPos = HRP.Position
    local mPos = nil
    if Murderer and Murderer.Character then
        local h = Murderer.Character:FindFirstChild("HumanoidRootPart")
        if h then mPos = h.Position end
    end
    local best, bestScore = nil, -math.huge
    for _, o in ipairs(CachedCoins) do
        if o.Parent then
            local score = -(o.Position - myPos).Magnitude * 0.3
            if mPos then
                score = score + (o.Position - mPos).Magnitude * 0.7
                if MapCenter then
                    local mSide = mPos - MapCenter
                    local cSide = o.Position - MapCenter
                    if mSide:Dot(cSide) < 0 then score = score + 100 end
                end
            end
            if score > bestScore then best, bestScore = o, score end
        end
    end
    return best
end

local function HorizontalDist(a, b)
    if not a or not b then return math.huge end
    local dx, dz = a.Position.X - b.Position.X, a.Position.Z - b.Position.Z
    return math.sqrt(dx * dx + dz * dz)
end

