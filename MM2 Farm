local function isCoin(o)
    return o:IsA("BasePart") and o.Name:match(CFG.COIN_PAT) and o.Transparency < 1
end

local function refreshCoins(force)
    local now = tick()
    if not force and now - lastScan < CFG.SCAN then return end
    lastScan = now
    coinCache = {}
    for _, o in ipairs(workspace:GetDescendants()) do
        if o.Parent and isCoin(o) then table.insert(coinCache, o) end
    end
end

local function nearestCoin(pos, maxDist)
    local best, bd = nil, maxDist or math.huge
    for _, c in ipairs(coinCache) do
        if c.Parent then
            local d = (c.Position - pos).Magnitude
            if d < bd then best, bd = c, d end
        end
    end
    return best, bd
end

local function getBagCoins()
    for _, name in ipairs({"Coins", "Coin", "CoinCount"}) do
        local v = player:FindFirstChild(name)
        if v and v:IsA("IntValue") then return v.Value end
    end
    local pg = player:FindFirstChild("PlayerGui")
    if pg then
        for _, o in ipairs(pg:GetDescendants()) do
            if o:IsA("IntValue") and o.Name:lower():find("coin") then return o.Value end
            if o:IsA("StringValue") and o.Name:lower():find("coin") then
                local n = tonumber(o.Value)
                if n then return n end
            end
        end
    end
    return nil
end

local function getRole()
    local c = player.Character
    if not c then return "Innocent" end
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") then
            local n = t.Name:lower()
            if n:find("knife") or n:find("murder") then return "Murderer" end
            if n:find("gun") or n:find("sheriff") then return "Sheriff" end
        end
    end
    return "Innocent"
end

local function getMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            for _, t in ipairs(p.Character:GetChildren()) do
                if t:IsA("Tool") and t.Name:lower():find("knife") then return p end
            end
        end
    end
    return nil
end

local function getMyTool(kw)
    local c = player.Character
    if not c then return nil end
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") and t.Name:lower():find(kw) then return t end
    end
    return nil
end

local function fireR(name, ...)
    local rem = RepStorage:FindFirstChild("Remotes")
    if rem then
        local r = rem:FindFirstChild(name)
        if r and r:IsA("RemoteEvent") then pcall(function() r:FireServer(...) end) end
    end
end

local function killAll()
    local knife = getMyTool("knife")
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local myc = player.Character
            local myhrp = myc and myc:FindFirstChild("HumanoidRootPart")
            if h and h.Health > 0 and hrp and myhrp then
                myhrp.CFrame = CFrame.lookAt(hrp.Position - hrp.CFrame.LookVector * 2, hrp.Position)
                if knife then pcall(function() knife:Activate() end) end
                fireR("Kill", p)
                fireR("Attack", p)
                task.wait(0.05)
            end
        end
    end
end

local function shootMurder()
    local m = getMurderer()
    if not m or not m.Character then return end
    local gun = getMyTool("gun") or getMyTool("sheriff")
    local myc = player.Character
    if not myc then return end
    local myhrp = myc:FindFirstChild("HumanoidRootPart")
    local thrp = m.Character:FindFirstChild("HumanoidRootPart")
    if not myhrp or not thrp then return end
    myhrp.CFrame = CFrame.lookAt(myhrp.Position, thrp.Position)
    if gun then pcall(function() gun:Activate() end) end
    fireR("Shoot", thrp.Position)
    fireR("Fire", thrp.Position)
    hasShot = true
end

local function flingMurder()
    local m = getMurderer()
    if not m or not m.Character then return end
    local h = m.Character:FindFirstChild("HumanoidRootPart")
    if not h then return end
    local bv = Instance.new("BodyAngularVelocity")
    bv.AngularVelocity = Vector3.new(math.huge, math.huge, math.huge)
    bv.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bv.Parent = h
    task.delay(1, function() if bv then bv:Destroy() end end)
end

local function setNoclip(on)
    local c = player.Character
    if not c then return end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = not on end
    end
end

