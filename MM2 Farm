local function FlyTowards(HRP, target, dt)
    local diff = target - HRP.Position
    local dist = diff.Magnitude
    if dist < 0.5 then HRP.Velocity = Vector3.zero; return dist end
    local step = math.min(FLY_SPEED * dt, dist)
    HRP.Velocity = Vector3.zero
    HRP.CFrame = CFrame.new(HRP.Position + diff.Unit * step)
    return dist
end

local function WalkTowardsXZ(HRP, targetPos, dt, speed)
    local dx = targetPos.X - HRP.Position.X
    local dz = targetPos.Z - HRP.Position.Z
    local horiz = math.sqrt(dx * dx + dz * dz)
    if horiz < 0.3 then return horiz end
    local step = math.min((speed or WALK_SPEED) * dt, horiz)
    local ux, uz = dx / horiz, dz / horiz
    HRP.CFrame = CFrame.new(HRP.Position.X + ux * step, HRP.Position.Y, HRP.Position.Z + uz * step)
    return horiz
end

local function UpdateCache()
    local now = tick()
    if now - LastCacheUpdate < 0.2 then return end
    LastCacheUpdate = now

    local raw = {}
    for _, o in ipairs(workspace:GetDescendants()) do
        if IsCoin(o) and o.Parent then
            table.insert(raw, o)
        end
    end

    if #raw == 0 then
        CachedCoins = {}
        MapCenter = nil
    else
        local minY = math.huge
        for _, o in ipairs(raw) do
            if o.Position.Y < minY then minY = o.Position.Y end
        end
        local filtered = {}
        for _, o in ipairs(raw) do
            if o.Position.Y < minY + 50 then
                table.insert(filtered, o)
            end
        end
        CachedCoins = filtered
        if #filtered > 0 then
            local sum = Vector3.zero
            for _, o in ipairs(filtered) do sum = sum + o.Position end
            MapCenter = sum / #filtered
        else
            MapCenter = nil
        end
    end

    CachedMurderer = nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                if p.Character:FindFirstChild("Knife") then CachedMurderer = p; break end
                local bp = p:FindFirstChild("Backpack")
                if bp and bp:FindFirstChild("Knife") then CachedMurderer = p; break end
            end
        end
    end

    for c, t in pairs(BadCoins) do
        if tick() - t > BAD_COIN_COOLDOWN or not c.Parent then
            BadCoins[c] = nil
        end
    end
end

