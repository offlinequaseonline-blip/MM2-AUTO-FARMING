local function UpdateCoinESP()
    if not Settings.ESPCoins then ClearCoinESP(); return end
    local HRP = GetHRP()
    if not HRP then return end
    local CamPos = Camera.CFrame.Position
    local MyChar = GetCharacter()

    local CoinList = {}
    for _, Obj in ipairs(workspace:GetDescendants()) do
        if IsCoin(Obj) and Obj.Parent then table.insert(CoinList, Obj) end
    end
    table.sort(CoinList, function(a, b)
        return (a.Position - HRP.Position).Magnitude < (b.Position - HRP.Position).Magnitude
    end)
    local ClosestCoins = {}
    for i = 1, math.min(10, #CoinList) do ClosestCoins[CoinList[i]] = true end

    for Coin, Data in pairs(ESPCoinData) do
        if not Coin or not Coin.Parent or not IsCoin(Coin) or not ClosestCoins[Coin] then
            DestroyESPData(Data)
            ESPCoinData[Coin] = nil
        end
    end

    for _, Coin in ipairs(CoinList) do
        if ClosestCoins[Coin] then
            if not ESPCoinData[Coin] then ESPCoinData[Coin] = CreateCoinESP(Coin) end
            local Data = ESPCoinData[Coin]
            if Data then
                local Direction = Coin.Position - CamPos
                local Distance = Direction.Magnitude
                local Params = RaycastParams.new()
                Params.FilterDescendantsInstances = {Coin, MyChar}
                Params.FilterType = Enum.RaycastFilterType.Exclude
                local Result = workspace:Raycast(CamPos, Direction, Params)
                local Occluded = Result ~= nil and Result.Distance < Distance - 2
                Data.Highlight.Enabled = Occluded
                Data.Billboard.Enabled = Occluded
                if Occluded then
                    local DistStuds = math.floor((Coin.Position - HRP.Position).Magnitude)
                    Data.Label.Text = string.format("%s | %d studs", Coin.Name, DistStuds)
                end
            end
        end
    end
end

local function UpdatePlayerESP()
    if not Settings.ESPPlayers then ClearPlayerESP(); return end
    local HRP = GetHRP()
    if not HRP then return end

    for Player, Data in pairs(ESPPlayerData) do
        local NeedRecreate = false
        if not Player or not Player.Character or not Player.Character.Parent then
            NeedRecreate = true
        elseif Data.Character ~= Player.Character then
            NeedRecreate = true
        end
        if NeedRecreate then
            DestroyESPData(Data)
            ESPPlayerData[Player] = nil
        end
    end

    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
            if not ESPPlayerData[Player] then
                ESPPlayerData[Player] = CreatePlayerESP(Player)
            end
            local Data = ESPPlayerData[Player]
            if Data then
                local Role = GetPlayerRole(Player)
                local Color
                if Role == "Murderer" then Color = Color3.fromRGB(255, 50, 50)
                elseif Role == "Sheriff" then Color = Color3.fromRGB(50, 150, 255)
                elseif Role == "Hero" then Color = Color3.fromRGB(255, 255, 0)
                else Color = Color3.fromRGB(50, 255, 50) end
                pcall(function()
                    Data.Highlight.FillColor = Color
                    Data.Highlight.OutlineColor = Color
                end)
                local TheirHRP = Player.Character:FindFirstChild("HumanoidRootPart")
                if TheirHRP then
                    local Dist = math.floor((TheirHRP.Position - HRP.Position).Magnitude)
                    Data.Label.Text = string.format("%s [%s] | %d studs", Player.Name, Role, Dist)
                    Data.Label.TextColor3 = Color
                end
            end
        end
    end
end

local function UpdateGunTracking()
    local AnyGunInPlay = false
    local GunPart = nil

    for _, Player in ipairs(Players:GetPlayers()) do
        if Player.Character and Player.Character:FindFirstChild("Gun") then AnyGunInPlay = true end
        local bp = Player:FindFirstChild("Backpack")
        if bp and bp:FindFirstChild("Gun") then AnyGunInPlay = true end
    end

    for _, Obj in ipairs(workspace:GetDescendants()) do
        if (Obj.Name == "Gun" or Obj.Name == "DroppedGun") and (Obj:IsA("Tool") or Obj:IsA("BasePart")) then
            AnyGunInPlay = true
            local isOwned = false
            for _, Player in ipairs(Players:GetPlayers()) do
                if Player.Character and Obj:IsDescendantOf(Player.Character) then isOwned = true; break end
                local bp = Player:FindFirstChild("Backpack")
                if bp and Obj:IsDescendantOf(bp) then isOwned = true; break end
            end
            if not isOwned then
                GunPart = Obj
                break
            end
        end
    end

    if not AnyGunInPlay and OriginalSheriff then OriginalSheriff = nil end

    if not Settings.ESPGun then ClearGunESP(); return end

    if GunPart then
        if not ESPGunData or ESPGunData.Instance ~= GunPart then
            ClearGunESP()
            ESPGunData = CreateGunESP(GunPart)
        end
        if not GunNotified then
            pcall(function()
                StarterGui:SetCore("SendNotification", {
                    Title = "Gun Dropped",
                    Text = "The Sheriff's gun has been dropped!",
                    Duration = 5
                })
            end)
            GunNotified = true
        end
    else
        ClearGunESP()
    end
end

