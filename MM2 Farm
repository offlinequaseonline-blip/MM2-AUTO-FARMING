local function GetBestCoin(HRP, Murderer)
    local myPos = HRP.Position
    local mPos = nil
    local murdererClose = false
    if Murderer and Murderer.Character then
        local h = Murderer.Character:FindFirstChild("HumanoidRootPart")
        local mHum = Murderer.Character:FindFirstChildOfClass("Humanoid")
        if h and mHum and mHum.Health > 0 then
            mPos = h.Position
            murdererClose = (mPos - myPos).Magnitude < FLEE_DIST
        end
    end

    local best, bestScore = nil, -math.huge
    for _, o in ipairs(CachedCoins) do
        if o.Parent and not BadCoins[o] then
            local yDiff = o.Position.Y - myPos.Y
            if yDiff <= MAX_COIN_ABOVE and yDiff >= MAX_COIN_BELOW then
                local score
                if murdererClose then
                    score = (o.Position - mPos).Magnitude - (o.Position - myPos).Magnitude * 0.15
                else
                    score = -(o.Position - myPos).Magnitude * 0.3
                    if mPos then
                        score = score + (o.Position - mPos).Magnitude * 0.7
                        if MapCenter then
                            local mSide = mPos - MapCenter
                            local cSide = o.Position - MapCenter
                            if mSide:Dot(cSide) < 0 then score = score + 100 end
                        end
                    end
                end
                if score > bestScore then best, bestScore = o, score end
            end
        end
    end
    return best
end

