local function GetCharacter() return LocalPlayer.Character end
local function GetHRP() local c = GetCharacter(); return c and c:FindFirstChild("HumanoidRootPart") end
local function GetHumanoid() local c = GetCharacter(); return c and c:FindFirstChildOfClass("Humanoid") end

local function IsCoin(Obj)
    return Obj:IsA("BasePart") and (Obj.Name:match("Coin") or Obj.Name:match("Candy") or Obj.Name:match("Treat")) and Obj.Transparency < 1
end

local function IsPlaying()
    local Char = GetCharacter()
    if not Char then return false end
    if Char ~= LastChar then
        LastChar = Char
        CharChangedAt = tick()
        HasActivatedFullBagAction = false
        HasShotMurder = false
        HasKilledAll = false
        SpecialAction = nil
        SpecialTarget = nil
        WalkPath = nil
        return false
    end
    if tick() - CharChangedAt < 2 then return false end
    local Hum = GetHumanoid()
    if not Hum or Hum.Health <= 0 or Hum.MaxHealth <= 0 then return false end
    return Char:FindFirstChild("HumanoidRootPart") ~= nil
end

local function GetNearestCoin(Pos)
    local Best, BestDist = nil, math.huge
    for _, Obj in ipairs(workspace:GetDescendants()) do
        if IsCoin(Obj) and Obj.Parent then
            local d = (Obj.Position - Pos).Magnitude
            if d < BestDist then Best, BestDist = Obj, d end
        end
    end
    return Best, BestDist
end

local function GetBagCoins()
    for _, Name in ipairs({"Coins", "Coin", "CoinCount", "Bag"}) do
        local v = LocalPlayer:FindFirstChild(Name)
        if v and v:IsA("IntValue") then return v.Value end
    end
    local LS = LocalPlayer:FindFirstChild("leaderstats")
    if LS then
        for _, Name in ipairs({"Coins", "Coin", "CoinCount"}) do
            local v = LS:FindFirstChild(Name)
            if v and v:IsA("IntValue") then return v.Value end
        end
    end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _, o in ipairs(pg:GetDescendants()) do
            if o:IsA("IntValue") and o.Name:lower():find("coin") then return o.Value end
            if o:IsA("TextLabel") and (o.Name:lower():find("coin") or o.Name:lower():find("bag")) then
                local clean = o.Text:gsub(",", ""):gsub("%s+", "")
                local n = tonumber(clean)
                if n then return n end
            end
        end
    end
    return nil
end

local function GetMyTool(Keyword)
    local Char = GetCharacter()
    if Char then
        for _, t in ipairs(Char:GetChildren()) do
            if t:IsA("Tool") and t.Name:lower():find(Keyword) then return t end
        end
    end
    local BP = LocalPlayer:FindFirstChild("Backpack")
    if BP then
        for _, t in ipairs(BP:GetChildren()) do
            if t:IsA("Tool") and t.Name:lower():find(Keyword) then return t end
        end
    end
    return nil
end

local function EquipTool(Keyword)
    local Char, Hum = GetCharacter(), GetHumanoid()
    if not Char or not Hum then return nil end
    local t = GetMyTool(Keyword)
    if not t then return nil end
    if t.Parent ~= Char then
        pcall(function() Hum:EquipTool(t) end)
        task.wait(0.15)
    end
    return GetMyTool(Keyword)
end

local function GetLocalRole()
    local Char = GetCharacter()
    if not Char then return "Innocent" end
    if Char:FindFirstChild("Knife") then return "Murderer" end
    if Char:FindFirstChild("Gun") then return "Sheriff" end
    local BP = LocalPlayer:FindFirstChild("Backpack")
    if BP then
        if BP:FindFirstChild("Knife") then return "Murderer" end
        if BP:FindFirstChild("Gun") then return "Sheriff" end
    end
    return "Innocent"
end

local function FindMurderer()
    for _, P in ipairs(Players:GetPlayers()) do
        if P ~= LocalPlayer and P.Character then
            local c = P.Character
            if c:FindFirstChild("Knife") then return P end
            local bp = P:FindFirstChild("Backpack")
            if bp and bp:FindFirstChild("Knife") then return P end
        end
    end
    return nil
end

local function IsGunDropped(Gun)
    for _, P in ipairs(Players:GetPlayers()) do
        if P.Character and Gun:IsDescendantOf(P.Character) then return false end
        local bp = P:FindFirstChild("Backpack")
        if bp and Gun:IsDescendantOf(bp) then return false end
    end
    return true
end

local function FindDroppedGun()
    for _, o in ipairs(workspace:GetDescendants()) do
        if (o.Name == "Gun" or o.Name == "DroppedGun") and (o:IsA("Tool") or o:IsA("BasePart")) then
            if IsGunDropped(o) then return o end
        end
    end
    return nil
end

local function KillAllPlayers()
    local Knife = EquipTool("knife")
    if not Knife then return end
    for _, P in ipairs(Players:GetPlayers()) do
        if P ~= LocalPlayer and P.Character then
            local TheirHum = P.Character:FindFirstChildOfClass("Humanoid")
            local TheirHRP = P.Character:FindFirstChild("HumanoidRootPart")
            local MyHRP = GetHRP()
            if TheirHum and TheirHum.Health > 0 and TheirHRP and MyHRP then
                MyHRP.CFrame = CFrame.lookAt(TheirHRP.Position - TheirHRP.CFrame.LookVector * 2, TheirHRP.Position)
                pcall(function() Knife:Activate() end)
                task.wait(0.08)
            end
        end
    end
    HasKilledAll = true
end

local function ShootMurderer()
    local Murderer = FindMurderer()
    if not Murderer or not Murderer.Character then return end
    local Gun = EquipTool("gun")
    if not Gun then return end
    local MyHRP = GetHRP()
    local TheirHRP = Murderer.Character:FindFirstChild("HumanoidRootPart")
    if not MyHRP or not TheirHRP then return end
    MyHRP.CFrame = CFrame.lookAt(MyHRP.Position, TheirHRP.Position)
    pcall(function() Gun:Activate() end)
    HasShotMurder = true
end

local function FlingMurderer()
    local Murderer = FindMurderer()
    if not Murderer or not Murderer.Character then return end
    local HRP = Murderer.Character:FindFirstChild("HumanoidRootPart")
    if not HRP then return end
    local BV = Instance.new("BodyAngularVelocity")
    BV.AngularVelocity = Vector3.new(math.huge, math.huge, math.huge)
    BV.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    BV.Parent = HRP
    task.delay(1, function() if BV then BV:Destroy() end end)
end

local function ServerHop()
    pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        local resp = HttpService:JSONDecode(game:HttpGet(url))
        for _, s in ipairs(resp.data or {}) do
            if s.playing < s.maxPlayers and s.id ~= game.JobId then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                return
            end
        end
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end)
end

