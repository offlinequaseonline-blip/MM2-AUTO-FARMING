local sliderValue = CONFIG.START_VALUE
local sliding = false
local function updateSlider()
    local pct = sliderValue / CONFIG.MAX_SLIDER
    fill.Size = UDim2.new(pct, 0, 1, 0)
    knob.Position = UDim2.new(pct, 0, 0.5, 0)
    speedLbl.Text = string.format("Velocidade: %d studs/%s", math.floor(sliderValue), CONFIG.SPEED_UNIT)
end
local function setFromX(x)
    local pct = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
    sliderValue = math.floor(pct * CONFIG.MAX_SLIDER)
    updateSlider()
end
track.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliding = true
        setFromX(input.Position.X)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliding = false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
