local function GetRole()
    local Char = GetCharacter()
    if not Char then return "Innocent" end
    for _, Tool in ipairs(Char:GetChildren()) do
        if Tool:IsA("Tool") then
            local Name = Tool.Name:lower()
            if Name:find("knife") or Name:find("murder") then return "Murderer" end
            if Name:find("gun") or Name:find("sheriff") then return "Sheriff" end
        end
    end
    return "Innocent"
end

RunService.RenderStepped:Connect(function(DeltaTime)
    local Char = GetCharacter()
    local HRP = GetHRP()
    local Hum = GetHumanoid()
    if not Char or not HRP or not Hum then return end

    local Now = tick()

    if Now - LastBagCheck > 1 then
        LastBagCheck = Now
        local RealBag = GetBagCoins()
        if RealBag ~= nil then
            LocalBagCoins = RealBag
        end
        BagLabel.Text = "Bag: " .. LocalBagCoins

        if LocalTotalCoins < LocalBagCoins then
            LocalTotalCoins = LocalBagCoins
        end
        TotalLabel.Text = "Total: " .. LocalTotalCoins

        local RealCandy = GetCandyCount()
        if RealCandy ~= nil then
            LocalCandyCoins = RealCandy
        end
        CandyLabel.Text = "Doces: " .. LocalCandyCoins

        TimeLabel.Text = string.format("Tempo: %ds", math.floor(Now - SessionStart))
    end

    if Settings.ESP and Now - LastESPUpdate > 0.5 then
        LastESPUpdate = Now
        for _, Billboard in ipairs(ESPBillboards) do
            if Billboard and Billboard.Parent then
                local Coin = Billboard.Parent
                local Label = Billboard:FindFirstChildOfClass("TextLabel")
                if Label and Coin:IsA("BasePart") then
                    Label.Text = string.format("%s | %.0f", Coin.Name, (Coin.Position - HRP.Position).Magnitude)
                end
            end
        end
    end

    if Now - LastServerHopCheck > 5 then
        LastServerHopCheck = Now
        local PlayerCount = #Players:GetPlayers()
        if PlayerCount < 2 then
            ServerHop()
        else
            for _, Player in ipairs(Players:GetPlayers()) do
                if Player ~= LocalPlayer then
                    local Name = Player.Name:lower()
                    if Name:find("admin") or Name:find("owner") or Name:find("mod") then
                        ServerHop()
                        break
                    end
                end
            end
        end
    end

    if not Settings.AutoFarm then return end

    local Nearest, Distance = GetNearestTarget(HRP.Position)
    if not Nearest then
        StatusLabel.Text = "Nenhum coin encontrado"
        return
    end

    local Watching = CheckSomeoneWatching()
    local SafeDistance = Watching and Settings.MinPlayerDistance or math.huge

    if Settings.Mode == "Fly" then
        Hum.PlatformStand = true
        workspace.Gravity = 0
        SetNoclip(true)

        if Distance > 6 then
            local Direction = (Nearest.Position - HRP.Position).Unit
            local Step = math.min(Settings.MaxSpeed * DeltaTime, Distance)
            if Distance > SafeDistance then
                HRP.CFrame = CFrame.new(HRP.Position + Direction * Step) * CFrame.Angles(0, math.atan2(-Direction.X, -Direction.Z), 0)
                StatusLabel.Text = string.format("Fly -> %.0f studs", Distance)
            else
                StatusLabel.Text = "Mantendo distância..."
            end
        else
            local Spin = tick() * 6
            local Bob = math.sin(tick() * 4) * 1.5
            HRP.CFrame = CFrame.new(Nearest.Position + Vector3.new(0, 2 + Bob, 0)) * CFrame.Angles(0, Spin, 0)
            StatusLabel.Text = "Coletando (Fly)..."
        end

    elseif Settings.Mode == "Tp" then
        Hum.PlatformStand = true
        workspace.Gravity = 0
        SetNoclip(true)

        if Distance > 6 then
            if Now - LastTPTime > Settings.TPValidationDelay then
                LastTPTime = Now
                local Offset = Vector3.new(
                    math.random(-2, 2),
                    math.random(0, 3),
                    math.random(-2, 2)
                )
                HRP.Velocity = Vector3.zero
                HRP.CFrame = CFrame.new(Nearest.Position + Offset)
            end
            StatusLabel.Text = string.format("TP -> %.0f studs (%.1fs)", Distance, Settings.TPValidationDelay)
        else
            HRP.Velocity = Vector3.zero
            local Spin = tick() * 6
            local Bob = math.sin(tick() * 4) * 1.5
            HRP.CFrame = CFrame.new(Nearest.Position + Vector3.new(0, 2 + Bob, 0)) * CFrame.Angles(0, Spin, 0)
            StatusLabel.Text = "Coletando (TP)..."
        end

    elseif Settings.Mode == "Walk" then
        Hum.PlatformStand = false
        Hum.WalkSpeed = math.clamp(Settings.MaxSpeed, 25, 100)
        workspace.Gravity = 196.2
        SetNoclip(true)

        if Distance > 6 then
            if Distance < 25 then
                Hum:MoveTo(Nearest.Position)
                if Nearest.Position.Y - HRP.Position.Y > 3 then
                    Hum.Jump = true
                end
            else
                if not WalkPath or (Now - LastTargetRefresh > 2) then
                    LastTargetRefresh = Now
                    WalkPath = PathfindingService:CreatePath({
                        AgentHeight = 5,
                        AgentRadius = 2,
                        AgentCanJump = true,
                        WaypointSpacing = 4
                    })
                    local Success = pcall(function()
                        WalkPath:ComputeAsync(HRP.Position, Nearest.Position)
                    end)
                    if not Success or WalkPath.Status ~= Enum.PathStatus.Success then
                        WalkPath = nil
                    end
                    WalkIndex = 1
                end

                if WalkPath then
                    local Waypoints = WalkPath:GetWaypoints()
                    if WalkIndex <= #Waypoints then
                        local Waypoint = Waypoints[WalkIndex]
                        if (HRP.Position - Waypoint.Position).Magnitude < 3 then
                            WalkIndex = WalkIndex + 1
                            Waypoint = Waypoints[math.min(WalkIndex, #Waypoints)]
                        end
                        Hum:MoveTo(Waypoint.Position)
                        if Waypoint.Action == Enum.PathWaypointAction.Jump then
                            Hum.Jump = true
                        end
                    end
                else
                    Hum:MoveTo(Nearest.Position)
                    if Nearest.Position.Y - HRP.Position.Y > 3 then
                        Hum.Jump = true
                    end
                end
            end
            StatusLabel.Text = string.format("Walk -> %.0f studs", Distance)
        else
            local Spin = tick() * 6
            local Bob = math.sin(tick() * 4) * 1.5
            HRP.CFrame = CFrame.new(Nearest.Position + Vector3.new(0, 2 + Bob, 0)) * CFrame.Angles(0, Spin, 0)
            StatusLabel.Text = "Coletando (Walk)..."
        end

        if (HRP.Position - LastPos).Magnitude < 0.5 then
            if Now - LastPosTime > 1.5 then
                Hum.Jump = true
                LastPosTime = Now
            end
        else
            LastPos = HRP.Position
            LastPosTime = Now
        end
    end

    if LocalBagCoins >= Settings.BagFullThreshold and not HasActivatedFullBagAction then
        HasActivatedFullBagAction = true
        FullBagActionTime = Now
        local Role = GetRole()
        if Role == "Murderer" then
            KillAllPlayers()
        elseif Role == "Sheriff" then
            ShootMurderer()
        end
    end

    if HasActivatedFullBagAction and not HasShotMurder and not HasKilledAll then
        local Role = GetRole()
        if Role == "Innocent" then
            local Gun = GetMyTool("gun")
            if Gun then
                ShootMurderer()
            elseif Now - FullBagActionTime > Settings.FlingDelay then
                FlingMurderer()
            end
        end
    end
end)
