local function GetCharacter() return LocalPlayer.Character end
local function GetHRP() local C = GetCharacter(); return C and C:FindFirstChild("HumanoidRootPart") end
local function GetHumanoid() local C = GetCharacter(); return C and C:FindFirstChildOfClass("Humanoid") end

local function IsCoin(Obj)
    return Obj:IsA("BasePart") and (Obj.Name:match("Coin") or Obj.Name:match("Candy") or Obj.Name:match("Treat")) and Obj.Transparency < 1
end

local function IsPlaying()
    local Char = GetCharacter()
    if not Char then return false end
    if Char ~= LastChar then
        LastChar = Char
        CharChangedAt = tick()
        OriginalSheriff = nil
        return false
    end
    if tick() - CharChangedAt < 2 then return false end
    local Hum = GetHumanoid()
    if not Hum or Hum.Health <= 0 or Hum.MaxHealth <= 0 then return false end
    return Char:FindFirstChild("HumanoidRootPart") ~= nil
end

local function GetNearestTarget(Position)
    local Best, BestDist = nil, math.huge
    for _, Obj in ipairs(workspace:GetDescendants()) do
        if IsCoin(Obj) and Obj.Parent then
            local Dist = (Obj.Position - Position).Magnitude
            if Dist < BestDist then Best, BestDist = Obj, Dist end
        end
    end
    return Best, BestDist
end

local function GetBagCoins()
    for _, Name in ipairs({"Coins", "Coin", "CoinCount", "Bag"}) do
        local Val = LocalPlayer:FindFirstChild(Name)
        if Val and Val:IsA("IntValue") then return Val.Value end
    end
    local LS = LocalPlayer:FindFirstChild("leaderstats")
    if LS then
        for _, Name in ipairs({"Coins", "Coin", "CoinCount"}) do
            local Val = LS:FindFirstChild(Name)
            if Val and Val:IsA("IntValue") then return Val.Value end
        end
    end
    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if PlayerGui then
        for _, Obj in ipairs(PlayerGui:GetDescendants()) do
            if Obj:IsA("IntValue") and Obj.Name:lower():find("coin") then return Obj.Value end
            if Obj:IsA("TextLabel") and (Obj.Name:lower():find("coin") or Obj.Name:lower():find("bag")) then
                local Clean = Obj.Text:gsub(",", ""):gsub("%s+", "")
                local Num = tonumber(Clean)
                if Num then return Num end
            end
        end
    end
    return nil
end

local function GetCandyCount()
    for _, Name in ipairs({"Candy", "Candies", "Treat", "Treats", "HalloweenCandy", "EventCandy", "CandyCount", "CandyAmount", "CandyBag", "RoundCandy"}) do
        local Val = LocalPlayer:FindFirstChild(Name)
        if Val and (Val:IsA("IntValue") or Val:IsA("NumberValue") or Val:IsA("StringValue")) then
            local n = tonumber(Val.Value)
            if n then return n end
        end
    end
    local Attr = LocalPlayer:GetAttribute("Candy") or LocalPlayer:GetAttribute("Candies")
    if Attr then local n = tonumber(Attr); if n then return n end end
    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if PlayerGui then
        for _, Obj in ipairs(PlayerGui:GetDescendants()) do
            if (Obj:IsA("IntValue") or Obj:IsA("NumberValue") or Obj:IsA("StringValue"))
                and (Obj.Name:lower():find("candy") or Obj.Name:lower():find("treat")) then
                local n = tonumber(Obj.Value)
                if n then return n end
            end
        end
        for _, Obj in ipairs(PlayerGui:GetDescendants()) do
            if Obj:IsA("TextLabel") and (Obj.Name:lower():find("candy") or Obj.Name:lower():find("treat")) then
                local Clean = Obj.Text:gsub(",", ""):gsub("%s+", "")
                local n = tonumber(Clean)
                if n then return n end
            end
        end
        for _, Obj in ipairs(PlayerGui:GetDescendants()) do
            if Obj:IsA("TextLabel") then
                local Clean = Obj.Text:gsub(",", ""):gsub("%s+", "")
                local n = tonumber(Clean)
                if n then
                    local p = Obj.Parent
                    local depth = 0
                    while p and depth < 3 do
                        if p.Name:lower():find("candy") or p.Name:lower():find("treat") then return n end
                        p = p.Parent
                        depth = depth + 1
                    end
                end
            end
        end
    end
    return nil
end

local function CheckSomeoneWatching()
    local MyHRP = GetHRP()
    if not MyHRP then return false end
    local MyChar = GetCharacter()
    local MyPos = MyHRP.Position
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and Player.Character then
            local TheirHRP = Player.Character:FindFirstChild("HumanoidRootPart")
            if TheirHRP then
                local ToMe = MyPos - TheirHRP.Position
                if ToMe.Magnitude < 150 and ToMe.Magnitude > 0.1 then
                    local Dot = TheirHRP.CFrame.LookVector:Dot(ToMe.Unit)
                    if Dot > 0 then
                        local Params = RaycastParams.new()
                        Params.FilterDescendantsInstances = {Player.Character, MyChar}
                        Params.FilterType = Enum.RaycastFilterType.Exclude
                        local Result = workspace:Raycast(TheirHRP.Position, ToMe, Params)
                        if not Result then return true end
                    end
                end
            end
        end
    end
    return false
end

local function GetPlayerRole(Player)
    local Char = Player.Character
    local Backpack = Player:FindFirstChild("Backpack")
    local HasKnife, HasGun = false, false
    if Char then
        if Char:FindFirstChild("Knife") then HasKnife = true end
        if Char:FindFirstChild("Gun") then HasGun = true end
    end
    if Backpack then
        if Backpack:FindFirstChild("Knife") then HasKnife = true end
        if Backpack:FindFirstChild("Gun") then HasGun = true end
    end
    if HasKnife then return "Murderer" end
    if HasGun then
        if not OriginalSheriff then
            OriginalSheriff = Player
            return "Sheriff"
        elseif OriginalSheriff == Player then
            return "Sheriff"
        else
            return "Hero"
        end
    end
    return "Innocent"
end

local function GetMyTool(Keyword)
    local Char = GetCharacter()
    if not Char then return nil end
    for _, Tool in ipairs(Char:GetChildren()) do
        if Tool:IsA("Tool") and Tool.Name:lower():find(Keyword) then return Tool end
    end
    return nil
end

local function FireRemote(RemoteName, ...)
    local Args = {...}
    local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if Remotes then
        local Remote = Remotes:FindFirstChild(RemoteName)
        if Remote and Remote:IsA("RemoteEvent") then
            pcall(function() Remote:FireServer(table.unpack(Args)) end)
        end
    end
end

local function KillAllPlayers()
    local Knife = GetMyTool("knife")
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and Player.Character then
            local TheirHum = Player.Character:FindFirstChildOfClass("Humanoid")
            local TheirHRP = Player.Character:FindFirstChild("HumanoidRootPart")
            local MyHRP = GetHRP()
            if TheirHum and TheirHum.Health > 0 and TheirHRP and MyHRP then
                MyHRP.CFrame = CFrame.lookAt(TheirHRP.Position - TheirHRP.CFrame.LookVector * 2, TheirHRP.Position)
                if Knife then pcall(function() Knife:Activate() end) end
                FireRemote("Kill", Player)
                FireRemote("Attack", Player)
                task.wait(KillAllDelay)
            end
        end
    end
    HasKilledAll = true
end

local function ShootMurderer()
    local Murderer
    for _, P in ipairs(Players:GetPlayers()) do
        if P ~= LocalPlayer and GetPlayerRole(P) == "Murderer" then Murderer = P; break end
    end
    if not Murderer or not Murderer.Character then return end
    local Gun = GetMyTool("gun") or GetMyTool("sheriff")
    local MyHRP = GetHRP()
    local TheirHRP = Murderer.Character:FindFirstChild("HumanoidRootPart")
    if not MyHRP or not TheirHRP then return end
    MyHRP.CFrame = CFrame.lookAt(MyHRP.Position, TheirHRP.Position)
    if Gun then pcall(function() Gun:Activate() end) end
    FireRemote("Shoot", TheirHRP.Position)
    FireRemote("Fire", TheirHRP.Position)
    HasShotMurder = true
end

local function FlingMurderer()
    local Murderer
    for _, P in ipairs(Players:GetPlayers()) do
        if P ~= LocalPlayer and GetPlayerRole(P) == "Murderer" then Murderer = P; break end
    end
    if not Murderer or not Murderer.Character then return end
    local HRP = Murderer.Character:FindFirstChild("HumanoidRootPart")
    if not HRP then return end
    local BV = Instance.new("BodyAngularVelocity")
    BV.AngularVelocity = Vector3.new(math.huge, math.huge, math.huge)
    BV.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    BV.Parent = HRP
    task.delay(1, function() if BV then BV:Destroy() end end)
end

local function ServerHop()
    pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        local success, response = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
        if not success or not response or not response.data then return end
        for _, server in ipairs(response.data) do
            if server.playing < server.maxPlayers and server.id ~= game.JobId then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                return
            end
        end
    end)
end

