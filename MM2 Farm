local function setMode(m)
    currentMode = m
    modeLbl.Text = "Modo: " .. m
    local sel = Color3.fromRGB(0, 120, 255)
    local ns = Color3.fromRGB(45, 50, 70)
    flyBtn.BackgroundColor3 = (m == "Fly") and sel or ns
    tpBtn.BackgroundColor3 = (m == "Tp") and sel or ns
    walkBtn.BackgroundColor3 = (m == "Walk") and sel or ns
    if active then
        local c = player.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if m == "Walk" then
            if h then
                h.PlatformStand = false
                h.WalkSpeed = math.clamp(sliderVal, CFG.WALK_MIN, CFG.WALK_MAX)
            end
            workspace.Gravity = savedGravity
            setNoclip(false)
        else
            if h then h.PlatformStand = true end
            workspace.Gravity = 0
            setNoclip(true)
        end
    end
end

local function startFarm()
    if not player.Character then return end
    active = true
    local c = player.Character
    local h = c:FindFirstChildOfClass("Humanoid")
    if currentMode == "Walk" then
        if h then
            h.PlatformStand = false
            h.WalkSpeed = math.clamp(sliderVal, CFG.WALK_MIN, CFG.WALK_MAX)
        end
        workspace.Gravity = savedGravity
        setNoclip(false)
    else
        if h then h.PlatformStand = true end
        workspace.Gravity = 0
        setNoclip(true)
    end
    refreshCoins(true)
    startBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    startBtn.Text = "PARAR FARM"
    statusLbl.Text = "Farm ativo: " .. currentMode
    statusLbl.TextColor3 = Color3.fromRGB(0, 255, 150)
end

local function stopFarm()
    active = false
    local c = player.Character
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then
            h.PlatformStand = false
            h.WalkSpeed = 16
            local hrp = c:FindFirstChild("HumanoidRootPart")
            if hrp then h:MoveTo(hrp.Position) end
        end
        setNoclip(false)
    end
    workspace.Gravity = savedGravity
    currentTarget = nil
    walkPath = nil
    startBtn.BackgroundColor3 = Color3.fromRGB(0, 160, 80)
    startBtn.Text = "INICIAR FARM"
    statusLbl.Text = "Pressione E ou clique INICIAR"
    statusLbl.TextColor3 = Color3.fromRGB(150, 160, 190)
    targetLbl.Text = ""
end

local function destroyEsp()
    for _, d in ipairs(espData) do
        if d.bb then d.bb:Destroy() end
    end
    espData = {}
end

local function buildEsp()
    destroyEsp()
    if not espOn then return end
    refreshCoins(true)
    for _, c in ipairs(coinCache) do
        if c.Parent then
            local bb = Instance.new("BillboardGui")
            bb.Size = UDim2.new(0, 220, 0, 45)
            bb.StudsOffset = Vector3.new(0, 2.5, 0)
            bb.AlwaysOnTop = true
            bb.MaxDistance = 800
            bb.Parent = c
            local tx = Instance.new("TextLabel")
            tx.Size = UDim2.new(1, 0, 1, 0)
            tx.BackgroundTransparency = 1
            tx.TextColor3 = Color3.fromRGB(0, 255, 180)
            tx.Font = Enum.Font.GothamBold
            tx.TextSize = 13
            tx.TextStrokeTransparency = 0
            tx.TextStrokeColor3 = Color3.new(0, 0, 0)
            tx.Text = c.Name
            tx.Parent = bb
            table.insert(espData, {bb = bb, tx = tx, coin = c})
        end
    end
end

local function checkVision()
    local c = player.Character
    if not c then return false end
    local myhrp = c:FindFirstChild("HumanoidRootPart")
    if not myhrp then return false end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local thrp = p.Character:FindFirstChild("HumanoidRootPart")
            if thrp then
                local to = myhrp.Position - thrp.Position
                if to.Magnitude < CFG.VIS_DIST then
                    local dot = thrp.CFrame.LookVector:Dot(to.Unit)
                    local ang = math.deg(math.acos(math.clamp(dot, -1, 1)))
                    if ang <= CFG.FOV then
                        local rp = RaycastParams.new()
                        rp.FilterDescendantsInstances = {p.Character}
                        rp.FilterType = Enum.RaycastFilterType.Exclude
                        local res = workspace:Raycast(thrp.Position, to, rp)
                        if res and res.Instance and res.Instance:IsDescendantOf(c) then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

