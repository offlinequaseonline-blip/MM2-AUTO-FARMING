local function SetModeVisual(Mode)
    local Selected = Color3.fromRGB(0, 120, 255)
    local Normal = Color3.fromRGB(45, 50, 70)
    FlyButton.BackgroundColor3 = (Mode == "Fly") and Selected or Normal
    TPButton.BackgroundColor3 = (Mode == "TP") and Selected or Normal
    WalkButton.BackgroundColor3 = (Mode == "Walk") and Selected or Normal
    ModeLabel.Text = "Mode: " .. Mode
end

local function SetMode(Mode)
    Settings.Mode = Mode
    SetModeVisual(Mode)
    if Settings.AutoFarm then
        local Hum = GetHumanoid()
        if Mode == "Walk" then
            if Hum then Hum.PlatformStand = false; Hum.WalkSpeed = math.clamp(Settings.MaxSpeed, 25, 50) end
            workspace.Gravity = 196.2
            SetNoclip(false)
        else
            if Hum then Hum.PlatformStand = true end
            workspace.Gravity = 0
            SetNoclip(true)
        end
    end
    SaveConfig()
end

local function StartAutoFarm()
    Settings.AutoFarm = true
    AutoFarmButton.Text = "STOP AUTO FARM"
    AutoFarmButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    StatusLabel.Text = "Farm active: " .. Settings.Mode
    StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
    SetMode(Settings.Mode)
    SaveConfig()
end

local function StopAutoFarm()
    Settings.AutoFarm = false
    AutoFarmButton.Text = "START AUTO FARM"
    AutoFarmButton.BackgroundColor3 = Color3.fromRGB(0, 160, 80)
    StatusLabel.Text = "Farm stopped"
    StatusLabel.TextColor3 = Color3.fromRGB(150, 160, 190)
    local Hum = GetHumanoid()
    if Hum then Hum.PlatformStand = false; Hum.WalkSpeed = 16 end
    workspace.Gravity = 196.2
    SetNoclip(false)
    CurrentTarget = nil
    WalkPath = nil
    SaveConfig()
end

