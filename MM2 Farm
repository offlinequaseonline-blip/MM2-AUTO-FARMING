local Sliding = false

local function UpdateSliderVisual()
    local Pct = math.clamp(Settings.MaxSpeed / 100, 0, 1)
    SpeedFill.Size = UDim2.new(Pct, 0, 1, 0)
    SpeedKnob.Position = UDim2.new(Pct, 0, 0.5, 0)
    SpeedLabel.Text = "Speed: " .. math.floor(Settings.MaxSpeed)
end

local function SetSpeedFromX(X)
    local Pct = math.clamp((X - SpeedTrack.AbsolutePosition.X) / SpeedTrack.AbsoluteSize.X, 0, 1)
    Settings.MaxSpeed = math.floor(Pct * 100)
    UpdateSliderVisual()
end

SpeedTrack.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
        Sliding = true
        SetSpeedFromX(Input.Position.X)
    end
end)

UserInputService.InputEnded:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
        if Sliding then
            Sliding = false
            SaveConfig()
        end
    end
end)

UserInputService.InputChanged:Connect(function(Input)
    if Sliding and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
        SetSpeedFromX(Input.Position.X)
    end
end)

UpdateSliderVisual()

