RS.RenderStepped:Connect(function(dt)
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local now = tick()

    if now - lastBagCheck > CFG.BAG_INT then
        lastBagCheck = now
        local bag = getBagCoins()
        if bag ~= nil then
            if bagBaseline == nil then bagBaseline = bag end
            sessionCoins = math.max(0, bag - bagBaseline)
            if bag > totalCoins then totalCoins = bag end
        end
        sessionLbl.Text = "Sessao: " .. sessionCoins
        totalLbl.Text = "Total: " .. totalCoins
        timeLbl.Text = "Tempo: " .. math.floor(now - sessionStart) .. "s"
    end

    if not hopping and now - lastHop > CFG.HOP_INT then
        lastHop = now
        local plrs = Players:GetPlayers()
        if #plrs < CFG.MIN_PLY then
            serverHop()
        else
            for _, p in ipairs(plrs) do
                if p ~= player then
                    local n = p.Name:lower()
                    if n:find("admin") or n:find("mod") or n:find("owner") then
                        serverHop()
                        break
                    end
                end
            end
        end
    end

    if espOn and now - lastEspUpd > CFG.ESP_INT then
        lastEspUpd = now
        local dead = false
        for _, d in ipairs(espData) do
            if d.coin and d.coin.Parent and d.tx then
                d.tx.Text = string.format("%s | %.0f", d.coin.Name, (d.coin.Position - hrp.Position).Magnitude)
            else
                dead = true
            end
        end
        if dead then buildEsp() end
    end

    if not active then return end

    refreshCoins(false)

    local vision = checkVision()
    local radius = vision and 50 or math.huge
    local tgt = nearestCoin(hrp.Position, radius)
    if not tgt then tgt = nearestCoin(hrp.Position, math.huge) end
    if not currentTarget or not currentTarget.Parent or currentTarget.Transparency >= 1
        or now - targetStart > CFG.RETARGET then
        currentTarget = tgt
        targetStart = now
        walkPath = nil
        walkLastTgt = nil
    end

    if not currentTarget then
        targetLbl.Text = "Nenhum coin"
        return
    end

    local dist = (currentTarget.Position - hrp.Position).Magnitude

    if currentMode == "Fly" then
        if hum then hum.PlatformStand = true end
        if dist > CFG.COIN_RAD then
            local step = math.min(sliderVal * dt, dist)
            local dir = (currentTarget.Position - hrp.Position).Unit
            hrp.CFrame = CFrame.new(hrp.Position + dir * step) * CFrame.Angles(0, math.atan2(-dir.X, -dir.Z), 0)
            targetLbl.Text = string.format("Fly -> %.0f", dist)
        else
            hrp.CFrame = CFrame.new(currentTarget.Position) * CFrame.Angles(0, tick() * 6, 0)
            targetLbl.Text = "Coletando..."
        end

    elseif currentMode == "Tp" then
        if hum then hum.PlatformStand = true end
        if dist > CFG.TP_RAD then
            if now - lastTp > CFG.TP_THROTTLE then
                lastTp = now
                local off = Vector3.new(
                    math.random(-CFG.TP_OFF, CFG.TP_OFF),
                    math.random(-CFG.TP_OFF, CFG.TP_OFF),
                    math.random(-CFG.TP_OFF, CFG.TP_OFF)
                )
                hrp.Velocity = Vector3.zero
                hrp.CFrame = CFrame.new(currentTarget.Position + off)
            end
            targetLbl.Text = string.format("TP -> %.0f", dist)
        else
            hrp.Velocity = Vector3.zero
            hrp.CFrame = CFrame.new(currentTarget.Position) * CFrame.Angles(0, tick() * 6, 0)
            targetLbl.Text = "Coletando..."
        end

    elseif currentMode == "Walk" then
        if hum then
            hum.PlatformStand = false
            hum.WalkSpeed = math.clamp(sliderVal, CFG.WALK_MIN, CFG.WALK_MAX)
        end
        if dist > CFG.COIN_RAD then
            if dist < 25 then
                hum:MoveTo(currentTarget.Position)
                if currentTarget.Position.Y - hrp.Position.Y > 3 then hum.Jump = true end
            else
                if walkLastTgt ~= currentTarget or now - lastPathComputed > CFG.PATH_INT then
                    walkLastTgt = currentTarget
                    lastPathComputed = now
                    walkWpIdx = 1
                    walkPath = PS:CreatePath({
                        AgentHeight = 5, AgentRadius = 2,
                        AgentCanJump = true, WaypointSpacing = 4
                    })
                    local ok = pcall(function() walkPath:ComputeAsync(hrp.Position, currentTarget.Position) end)
                    if not ok or walkPath.Status ~= Enum.PathStatus.Success then walkPath = nil end
                end
                if walkPath then
                    local wps = walkPath:GetWaypoints()
                    if walkWpIdx <= #wps then
                        local wp = wps[walkWpIdx]
                        if (hrp.Position - wp.Position).Magnitude < 3 then
                            walkWpIdx = walkWpIdx + 1
                            wp = wps[math.min(walkWpIdx, #wps)]
                        end
                        hum:MoveTo(wp.Position)
                        if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
                    end
                else
                    hum:MoveTo(currentTarget.Position)
                    if currentTarget.Position.Y - hrp.Position.Y > 3 then hum.Jump = true end
                end
            end
            targetLbl.Text = string.format("Walk -> %.0f", dist)
        else
            targetLbl.Text = "Coletando..."
        end

        if (hrp.Position - lastPos).Magnitude < 0.5 then
            if now - lastPosTime > 1.5 then
                hum.Jump = true
                lastPosTime = now
            end
        else
            lastPos = hrp.Position
            lastPosTime = now
        end
    end

    if sessionCoins >= 50 and not hasShot and not hasKilledAll then
        local role = getRole()
        if role == "Murderer" then
            killAll()
            hasKilledAll = true
        elseif role == "Sheriff" then
            shootMurder()
        elseif role == "Innocent" then
            local gun = getMyTool("gun")
            if gun then
                shootMurder()
            else
                gunTimer = gunTimer + dt
                if gunTimer > CFG.FLING_DELAY then
                    flingMurder()
                    gunTimer = 0
                end
            end
        end
    end
end)
