local function ClearCoinESP()
    for _, d in pairs(ESPCoinData) do
        pcall(function() if d.Highlight then d.Highlight:Destroy() end end)
        pcall(function() if d.Billboard then d.Billboard:Destroy() end end)
    end
    ESPCoinData = {}
end

local function UpdateCoinESP()
    if not Settings.ESPCoins then ClearCoinESP(); return end
    local HRP = GetHRP()
    if not HRP then return end
    local CamPos = Camera.CFrame.Position
    local MyChar = GetCharacter()

    local list = {}
    for _, o in ipairs(CachedCoins) do
        if o.Parent then table.insert(list, o) end
    end
    table.sort(list, function(a, b)
        return (a.Position - HRP.Position).Magnitude < (b.Position - HRP.Position).Magnitude
    end)
    local closest = {}
    for i = 1, math.min(10, #list) do closest[list[i]] = true end

    for coin, d in pairs(ESPCoinData) do
        if not coin or not coin.Parent or not closest[coin] then
            pcall(function() if d.Highlight then d.Highlight:Destroy() end end)
            pcall(function() if d.Billboard then d.Billboard:Destroy() end end)
            ESPCoinData[coin] = nil
        end
    end

    for _, coin in ipairs(list) do
        if closest[coin] then
            if not ESPCoinData[coin] then ESPCoinData[coin] = CreateCoinESP(coin) end
            local d = ESPCoinData[coin]
            if d then
                local dir = coin.Position - CamPos
                local dist = dir.Magnitude
                local params = RaycastParams.new()
                params.FilterDescendantsInstances = {coin, MyChar}
                params.FilterType = Enum.RaycastFilterType.Exclude
                local res = workspace:Raycast(CamPos, dir, params)
                local occluded = res ~= nil and res.Distance < dist - 2
                d.Highlight.Enabled = occluded
                d.Billboard.Enabled = occluded
                if occluded then
                    d.Label.Text = string.format("%s | %d", coin.Name, math.floor((coin.Position - HRP.Position).Magnitude))
                end
            end
        end
    end
end

