-- ===================== STATE HANDLERS =====================

local function HandleWaitingMatch(dt)
    local HRP, Hum = GetHRP(), GetHumanoid()
    if not HRP or not Hum then StatusLbl.Text = "Waiting char..."; return end
    if Hum.Health <= 0 then StatusLbl.Text = "Dead, waiting..."; return end
    EnableFly()
    HRP.Velocity = Vector3.zero
    if IsMatchActive() and IsPlaying() and tick() - CharChangedAt > 1 then
        FarmState = "FlyingToMap"
        FlyMapStart = tick()
        StatusLbl.Text = "Match! Flying to map..."
        return
    end
    StatusLbl.Text = "Waiting for match..."
end

local function HandleFlyingToMap(dt)
    local HRP, Hum = GetHRP(), GetHumanoid()
    if not HRP or not Hum or Hum.Health <= 0 then return end
    EnableFly()

    if FlyMapStart == 0 then FlyMapStart = tick() end

    local target, bestDist = nil, math.huge
    for _, o in ipairs(CachedCoins) do
        if o.Parent and not BadCoins[o] then
            local d = (o.Position - HRP.Position).Magnitude
            if d < bestDist then target = o.Position; bestDist = d end
        end
    end

    if not target then
        if tick() - FlyMapStart > FLY_MAP_TIMEOUT then
            FarmState = "WaitingMatch"
            FlyMapStart = 0
            StatusLbl.Text = "No map found"
            return
        end
        StatusLbl.Text = "Searching map..."
        return
    end

    -- Reject suspicious targets (way above or below current pos)
    if math.abs(target.Y - HRP.Position.Y) > 150 then
        FarmState = "WaitingMatch"
        FlyMapStart = 0
        StatusLbl.Text = "Bad map target, waiting"
        return
    end

    local dist = FlyTowards(HRP, target, dt)
    StatusLbl.Text = string.format("Flying to map: %.0f", dist)

    if dist < 15 then
        FarmState = "Farming"
        FlyMapStart = 0
        LastPos = HRP.Position
        StuckStart = nil
    end
end

local function HandleFarming(dt)
    local HRP, Hum = GetHRP(), GetHumanoid()
    if not HRP or not Hum or Hum.Health <= 0 then return end

    Hum.PlatformStand = true
    workspace.Gravity = 0
    ApplyNoclip()

    -- Y HARD FAILSAFE: if we're way too high above map center, snap down
    if MapCenter and HRP.Position.Y > MapCenter.Y + Y_HARD_CAP then
        HRP.CFrame = CFrame.new(HRP.Position.X, MapCenter.Y + 5, HRP.Position.Z)
        HRP.Velocity = Vector3.zero
        StatusLbl.Text = "Y hard failsafe!"
        return
    end

    local m = CachedMurderer
    local mHRP = nil
    local murdererClose = false
    if m and m.Character then
        local mHum = m.Character:FindFirstChildOfClass("Humanoid")
        if mHum and mHum.Health > 0 then
            mHRP = m.Character:FindFirstChild("HumanoidRootPart")
            if mHRP then
                murdererClose = (mHRP.Position - HRP.Position).Magnitude < FLEE_DIST
            end
        end
    end

    -- Gun pickup only if safe
    if GetLocalRole() == "Innocent" and not GetMyTool("gun") then
        local gun = FindDroppedGun()
        if gun then
            local handle = gun:FindFirstChild("Handle") or gun:FindFirstChildWhichIsA("BasePart")
            if handle then
                local gunSafe = true
                if mHRP then
                    if (handle.Position - mHRP.Position).Magnitude < FLEE_DIST and murdererClose then
                        gunSafe = false
                    end
                end
                -- Also reject if the gun is far above (unreachable by walk)
                if handle.Position.Y - HRP.Position.Y > MAX_COIN_ABOVE then
                    gunSafe = false
                end
                if gunSafe then
                    GunPickupTarget = gun
                    GunPickupStart = tick()
                    FarmState = "PickingGun"
                    StatusLbl.Text = "Picking up gun!"
                    return
                end
            end
        end
    end

    local target = GetBestCoin(HRP, m)
    if not target then
        if not NoCoinStart then NoCoinStart = tick() end
        if tick() - NoCoinStart > NO_COIN_TIMEOUT then
            FarmState = "WaitingMatch"
            NoCoinStart = nil
            StatusLbl.Text = "Match ended"
            return
        end
        StatusLbl.Text = "No reachable coins"
        return
    end
    NoCoinStart = nil

    local yDiff = target.Position.Y - HRP.Position.Y

    -- The Y-drift: only small climbs (2-6 studs), max 6 studs/sec
    if yDiff > 2 and yDiff <= MAX_COIN_ABOVE then
        local maxStep = math.min(yDiff - 1, Y_CLIMB_RATE * dt)
        if maxStep > 0.01 then
            HRP.CFrame = HRP.CFrame + Vector3.new(0, maxStep, 0)
        end
    end

    -- Walk horizontally (XZ only) toward the coin
    local horizDist = WalkTowardsXZ(HRP, target.Position, dt, WALK_SPEED)

    -- Snap XZ when very close (no Y change)
    if horizDist < 3 then
        HRP.CFrame = CFrame.new(target.Position.X, HRP.Position.Y, target.Position.Z)
    end

    if murdererClose then
        StatusLbl.Text = string.format("Fleeing! -> %.0f", horizDist)
    else
        StatusLbl.Text = string.format("Farm -> %.0f", horizDist)
    end

    -- Stuck detection (only when far)
    if horizDist > 12 then
        if (HRP.Position - LastPos).Magnitude < 0.5 then
            if not StuckStart then StuckStart = tick() end
            if tick() - StuckStart > STUCK_TIME_LIMIT then
                BadCoins[target] = tick()
                StuckStart = nil
                StatusLbl.Text = "Stuck, skipping coin"
                return
            end
        else
            StuckStart = nil
            LastPos = HRP.Position
        end
    else
        StuckStart = nil
        LastPos = HRP.Position
    end
end

local function HandlePickingGun(dt)
    local HRP, Hum = GetHRP(), GetHumanoid()
    if not HRP or not Hum or Hum.Health <= 0 then return end

    if not GunPickupTarget or not GunPickupTarget.Parent then
        GunPickupTarget = nil; FarmState = "Farming"; return
    end

    local handle = GunPickupTarget:FindFirstChild("Handle") or GunPickupTarget:FindFirstChildWhichIsA("BasePart")
    if not handle then
        GunPickupTarget = nil; FarmState = "Farming"; return
    end

    if tick() - GunPickupStart > GUN_TIMEOUT then
        GunPickupTarget = nil; FarmState = "Farming"
        StatusLbl.Text = "Gun timeout"
        return
    end

    local owned = false
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and GunPickupTarget:IsDescendantOf(p.Character) then owned = true; break end
        local bp = p:FindFirstChild("Backpack")
        if bp and GunPickupTarget:IsDescendantOf(bp) then owned = true; break end
    end
    if owned or GetMyTool("gun") then
        GunPickupTarget = nil; FarmState = "Farming"; return
    end

    local m = CachedMurderer
    local mHRP = nil
    if m and m.Character then
        local mHum = m.Character:FindFirstChildOfClass("Humanoid")
        if mHum and mHum.Health > 0 then
            mHRP = m.Character:FindFirstChild("HumanoidRootPart")
        end
    end
    if mHRP and (mHRP.Position - HRP.Position).Magnitude < FLEE_DIST then
        GunPickupTarget = nil; FarmState = "Farming"
        StatusLbl.Text = "Murderer close, skip gun"
        return
    end

    Hum.PlatformStand = true
    workspace.Gravity = 0
    ApplyNoclip()

    -- Y failsafe
    if MapCenter and HRP.Position.Y > MapCenter.Y + Y_HARD_CAP then
        HRP.CFrame = CFrame.new(HRP.Position.X, MapCenter.Y + 5, HRP.Position.Z)
        HRP.Velocity = Vector3.zero
        return
    end

    local yDiff = handle.Position.Y - HRP.Position.Y
    if yDiff > 2 and yDiff <= MAX_COIN_ABOVE then
        local maxStep = math.min(yDiff - 1, Y_CLIMB_RATE * dt)
        if maxStep > 0.01 then
            HRP.CFrame = HRP.CFrame + Vector3.new(0, maxStep, 0)
        end
    end

    local horizDist = WalkTowardsXZ(HRP, handle.Position, dt, WALK_SPEED)

    if horizDist < 3 then
        HRP.CFrame = CFrame.new(handle.Position.X, HRP.Position.Y, handle.Position.Z)
    end

    StatusLbl.Text = string.format("Getting gun: %.0f", horizDist)
end

RunService.RenderStepped:Connect(function(dt)
    UpdateCache()
    local HRP = GetHRP()

    if tick() - LastESPUpdate > 0.25 then
        LastESPUpdate = tick()
        UpdateCoinESP()
    end

    if tick() - LastBagCheck > 1 then
        LastBagCheck = tick()
        local bag = GetBagCoins()
        if bag ~= nil then LocalBagCoins = bag end
        BagLbl.Text = "Bag: " .. LocalBagCoins .. " / " .. BAG_THRESHOLD
    end

    if #Players:GetPlayers() <= 1 then
        if not AloneStartTime then AloneStartTime = tick() end
        if tick() - AloneStartTime > ALONE_TIMEOUT then
            AloneStartTime = nil
            ServerHop()
            return
        end
    else
        AloneStartTime = nil
    end

    if not Settings.AutoFarm then return end
    if not HRP then return end

    -- Global position failsafe
    if tick() - LastFailsafe > 3 then
        LastFailsafe = tick()
        if MapCenter and (HRP.Position - MapCenter).Magnitude > FAILSAFE_DIST then
            HRP.CFrame = CFrame.new(MapCenter + Vector3.new(0, 10, 0))
            HRP.Velocity = Vector3.zero
            StatusLbl.Text = "Position failsafe!"
            return
        end
    end

    -- Void rescue (teleport, not fly)
    if HRP.Position.Y < VOID_Y then
        local safeY = (MapCenter and MapCenter.Y or 5) + 10
        HRP.CFrame = CFrame.new(HRP.Position.X, safeY, HRP.Position.Z)
        HRP.Velocity = Vector3.zero
        StatusLbl.Text = "Void rescue!"
        return
    end

    if LocalBagCoins < BAG_THRESHOLD and HasActivatedFullBagAction then
        HasActivatedFullBagAction = false
        HasShotMurder = false
        HasKilledAll = false
    end

    if LocalBagCoins >= BAG_THRESHOLD and not HasActivatedFullBagAction then
        HasActivatedFullBagAction = true
        local role = GetLocalRole()
        if role == "Murderer" then
            KillAllPlayers()
        elseif role == "Sheriff" then
            ShootMurderer()
        elseif role == "Innocent" then
            if GetMyTool("gun") then
                ShootMurderer()
            elseif FindDroppedGun() then
                GunPickupTarget = FindDroppedGun()
                GunPickupStart = tick()
                FarmState = "PickingGun"
            else
                FlingMurderer()
            end
        end
    end

    if FarmState == "WaitingMatch" then HandleWaitingMatch(dt)
    elseif FarmState == "FlyingToMap" then HandleFlyingToMap(dt)
    elseif FarmState == "Farming" then HandleFarming(dt)
    elseif FarmState == "PickingGun" then HandlePickingGun(dt)
    end
end)
