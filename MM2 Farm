RunService.RenderStepped:Connect(function(dt)
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hum = char:FindFirstChildOfClass("Humanoid")

    local now = tick()
    if now - lastBagCheck > CONFIG.BAG_CHECK_INTERVAL then
        lastBagCheck = now
        local bag = getBagCoins()
        if bag then
            if sessionCoins == 0 then totalCoins = bag end
            sessionCoins = bag - (totalCoins or bag) + sessionCoins
            totalCoins = math.max(totalCoins, bag)
        end
        sessionCoinsLbl.Text = string.format("Sessão: %d", sessionCoins)
        totalCoinsLbl.Text = string.format("Total: %d", totalCoins)
        timeLbl.Text = string.format("Tempo: %ds", math.floor(now - sessionStart))
    end

    checkServerHop()

    if flying then
        if hum then hum.PlatformStand = true end
        local speed = CONFIG.SPEED_UNIT == "hora" and (sliderValue / 3600) or sliderValue

        if currentMode == "Tp" then
            refreshCoins()
            local nearest, bestDist = nil, math.huge
            for _, coin in ipairs(coinCache) do
                if coin.Parent then
                    local d = (coin.Position - hrp.Position).Magnitude
                    if d < bestDist then nearest, bestDist = coin, d end
                end
            end
            if nearest and bestDist > CONFIG.COIN_RADIUS then
                bypassTp(nearest.Position)
                targetLbl.Text = string.format("TP: %s (%.1f)", nearest.Name, bestDist)
            elseif nearest then
                hrp.CFrame = CFrame.new(nearest.Position) * CFrame.Angles(0, math.rad(tick() * 360), 0)
                targetLbl.Text = "Coletando..."
            end
        elseif currentMode == "Walk" then
            if not currentTarget or not currentTarget.Parent or currentTarget.Transparency >= 1 then
                refreshCoins()
                local nearest, bestDist = nil, math.huge
                for _, coin in ipairs(coinCache) do
                    if coin.Parent then
                        local d = (coin.Position - hrp.Position).Magnitude
                        if d < bestDist then nearest, bestDist = coin, d end
                    end
                end
                currentTarget = nearest
                walkPath = nil
                walkIndex = 1
            end
            if currentTarget then
                local dist = (currentTarget.Position - hrp.Position).Magnitude
                local vision = checkVision()
                local stopDist = vision and 50 or 100
                if dist > stopDist then
                    local path = PathfindingService:CreatePath()
                    local success, err = pcall(function()
                        path:ComputeAsync(hrp.Position, currentTarget.Position)
                    end)
                    if success and path.Status == Enum.PathStatus.Success then
                        local waypoints = path:GetWaypoints()
                        if walkIndex <= #waypoints then
                            local wp = waypoints[walkIndex]
                            if (hrp.Position - wp.Position).Magnitude < 3 then
                                walkIndex = walkIndex + 1
                            else
                                hum:MoveTo(wp.Position)
                                if wp.Action == Enum.PathWaypointAction.Jump then
                                    hum.Jump = true
                                end
                            end
                        end
                    end
                else
                    hum:MoveTo(currentTarget.Position)
                end
            end
        else
            local look = camera.CFrame.LookVector
            local right = camera.CFrame.RightVector
            local move = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += look end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= look end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= right end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += right end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.yAxis end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then move -= Vector3.yAxis end
            if move.Magnitude < 0.01 then move = look end
            local dir = move.Unit
            hrp.CFrame = CFrame.new(hrp.Position + dir * speed * dt) * CFrame.Angles(0, math.atan2(-dir.X, -dir.Z), 0)
            refreshCoins()
            local nearest, bestDist = nil, math.huge
            for _, coin in ipairs(coinCache) do
                if coin.Parent then
                    local d = (coin.Position - hrp.Position).Magnitude
                    if d < bestDist then nearest, bestDist = coin, d end
                end
            end
            if nearest then
                local vision = checkVision()
                local stopDist = vision and 50 or 100
                if bestDist < stopDist then
                    hrp.CFrame = CFrame.new(nearest.Position) * CFrame.Angles(0, math.rad(tick() * 360), 0)
                end
            end
        end

        local role = getPlayerRole()
        if sessionCoins >= 50 then
            if role == "Murderer" and not hasKilledAll then
                killAll()
                hasKilledAll = true
            elseif role == "Innocent" and not hasShotMurder then
                shootMurder()
            elseif role == "Sheriff" and not hasShotMurder then
                shootMurder()
            end
            if not hasShotMurder and not hasKilledAll then
                gunDroppedTimer = gunDroppedTimer + dt
                if gunDroppedTimer > CONFIG.FLING_DELAY then
                    flingMurder()
                    gunDroppedTimer = 0
                end
            end
        end
    end
end)
