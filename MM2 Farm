local function WalkToTarget(Target, HRP, Hum, Now)
    local Dist = (Target.Position - HRP.Position).Magnitude
    if Dist > 25 then
        if not WalkPath or (Now - LastTargetRefresh > 2) then
            LastTargetRefresh = Now
            WalkPath = PathfindingService:CreatePath({
                AgentHeight = 5, AgentRadius = 2, AgentCanJump = true, WaypointSpacing = 4
            })
            local ok = pcall(function() WalkPath:ComputeAsync(HRP.Position, Target.Position) end)
            if not ok or WalkPath.Status ~= Enum.PathStatus.Success then WalkPath = nil end
            WalkIndex = 1
        end
        if WalkPath then
            local wps = WalkPath:GetWaypoints()
            if WalkIndex <= #wps then
                local wp = wps[WalkIndex]
                if (HRP.Position - wp.Position).Magnitude < 3 then
                    WalkIndex = WalkIndex + 1
                    wp = wps[math.min(WalkIndex, #wps)]
                end
                Hum:MoveTo(wp.Position)
                if wp.Action == Enum.PathWaypointAction.Jump then Hum.Jump = true end
            end
        else
            Hum:MoveTo(Target.Position)
        end
    else
        Hum:MoveTo(Target.Position)
    end
    return Dist
end

RunService.RenderStepped:Connect(function(dt)
    local Now = tick()
    local Char, HRP, Hum = GetCharacter(), GetHRP(), GetHumanoid()

    if Now - LastESPUpdate > 0.25 then
        LastESPUpdate = Now
        UpdateCoinESP()
    end

    if Now - LastBagCheck > 1 then
        LastBagCheck = Now
        local bag = GetBagCoins()
        if bag ~= nil then LocalBagCoins = bag end
        BagLbl.Text = "Bag: " .. LocalBagCoins .. " / " .. BAG_THRESHOLD
    end

    if #Players:GetPlayers() <= 1 then
        if not AloneStartTime then AloneStartTime = Now end
        if Now - AloneStartTime > ALONE_TIMEOUT then
            AloneStartTime = nil
            ServerHop()
            return
        end
    else
        AloneStartTime = nil
    end

    if not Settings.AutoFarm then Status.Text = "Idle"; return end
    if not Char or not HRP or not Hum then Status.Text = "No character"; return end
    if not IsPlaying() then
        Hum.PlatformStand = false
        Hum.WalkSpeed = 16
        Status.Text = "Waiting for match..."
        return
    end

    if LocalBagCoins < BAG_THRESHOLD and HasActivatedFullBagAction then
        HasActivatedFullBagAction = false
        HasShotMurder = false
        HasKilledAll = false
        SpecialAction = nil
        SpecialTarget = nil
    end

    if LocalBagCoins >= BAG_THRESHOLD and not HasActivatedFullBagAction then
        HasActivatedFullBagAction = true
        local role = GetLocalRole()
        if role == "Murderer" then
            KillAllPlayers()
        elseif role == "Sheriff" then
            ShootMurderer()
        else
            local DroppedGun = FindDroppedGun()
            if DroppedGun then
                SpecialAction = "GetGun"
                SpecialTarget = DroppedGun
            else
                FlingMurderer()
            end
        end
    end

    Hum.PlatformStand = false
    Hum.WalkSpeed = WALK_SPEED
    workspace.Gravity = 196.2
    if Now - LastNoclipApply > 0.5 then
        LastNoclipApply = Now
        SetNoclip(true)
    end

    if HRP.Position.Y < VOID_Y then
        HRP.CFrame = CFrame.new(HRP.Position.X, RESCUE_Y, HRP.Position.Z)
        HRP.Velocity = Vector3.zero
        Status.Text = "Void rescue!"
        return
    end

    local Murderer = FindMurderer()
    if Murderer and Murderer.Character then
        local MHRP = Murderer.Character:FindFirstChild("HumanoidRootPart")
        if MHRP then
            local d = (MHRP.Position - HRP.Position).Magnitude
            if d < FLEE_DIST then
                local FleeDir = (HRP.Position - MHRP.Position).Unit
                Hum:MoveTo(HRP.Position + FleeDir * FLEE_STEP)
                Status.Text = string.format("Fleeing! (%.0f)", d)
                return
            end
        end
    end

    if SpecialAction == "GetGun" then
        local Gun = SpecialTarget
        if not Gun or not Gun.Parent or not IsGunDropped(Gun) then
            local m = FindMurderer()
            if m then FlingMurderer() end
            SpecialAction = nil
            SpecialTarget = nil
        elseif GetMyTool("gun") then
            ShootMurderer()
            SpecialAction = nil
            SpecialTarget = nil
        else
            local d = (Gun.Position - HRP.Position).Magnitude
            if d > 5 then
                Hum:MoveTo(Gun.Position)
                Status.Text = string.format("Getting gun (%.0f)", d)
            else
                HRP.CFrame = CFrame.new(Gun.Position + Vector3.new(0, 3, 0))
                Status.Text = "Picking gun..."
            end
            return
        end
    end

    local Coin, CoinDist = GetNearestCoin(HRP.Position)
    if not Coin then Status.Text = "No coins"; return end

    WalkToTarget(Coin, HRP, Hum, Now)
    Status.Text = string.format("Walk -> %.0f", CoinDist)

    if (HRP.Position - LastPos).Magnitude < 0.5 then
        if Now - LastPosTime > 1.5 then
            Hum.Jump = true
            LastPosTime = Now
        end
    else
        LastPos = HRP.Position
        LastPosTime = Now
    end
end)
